# Build context for apps/demo, apps/site and apps/web's Dockerfiles is the repo
# root, not the app directory — both need workspace deps, and the demo needs
# the desktop bundle. Only excludes what a fresh `pnpm install` + filtered
# `pnpm run build` never reads.
node_modules

# Rebuilt inside the image; a stale local copy must never leak into it.
packages/*/dist
apps/*/dist
packages/*/tsconfig.tsbuildinfo
apps/*/tsconfig.tsbuildinfo
tsconfig.tsbuildinfo
dist-sidecar

# The image only needs the `git` binary (installed via apk) to seed and run
# sessions, never this repo's own history.
.git

# Dev-only surfaces neither the demo server nor the desktop web build touch.
apps/desktop/src-tauri
# The site build reads the shipping app version from this one file.
!apps/desktop/src-tauri/tauri.conf.json
apps/desktop/e2e
# playwright.config.ts is typechecked by the desktop build (tsconfig.e2e.json)
# and imports this one file, so it rides along; the specs and snapshots do not.
!apps/desktop/e2e/paths.ts
.superpowers
.agents
.dispatch
.github
.vscode
docs

# moon's local task cache — potentially hundreds of MB of hashes and cached
# outputs, and the image never runs moon (the build uses pnpm directly).
.moon/cache

# apps/web's local dev database (moonx web:dev).
apps/web/data
