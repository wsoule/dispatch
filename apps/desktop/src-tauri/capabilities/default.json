{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's permissions: Tauri's core defaults, the plugins it uses, and each of the app's own commands by name",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-theme",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:default",
    "deep-link:default",
    "allow-git-setup-status",
    "allow-install-git",
    "allow-set-git-identity",
    "allow-project-folder-state",
    "allow-prepare-project-folder",
    "allow-install-cli-command",
    "allow-list-projects",
    "allow-list-sessions",
    "allow-get-session-detail",
    "allow-open-in-editor",
    "allow-dashboard-stats",
    "allow-generate-report",
    "allow-export-report",
    "allow-export-transcript",
    "allow-reveal-in-finder",
    "allow-get-file-diff-for-session-file",
    "allow-open-url",
    "allow-ensure-dispatchd",
    "allow-restart-dispatchd",
    "allow-has-dispatch",
    "allow-current-project-root",
    "allow-list-registered-projects",
    "allow-add-project",
    "allow-touch-project-opened",
    "allow-list-github-repos",
    "allow-clone-github-repo",
    "allow-download-workspace-file",
    "allow-remember-window-theme"
  ]
}
