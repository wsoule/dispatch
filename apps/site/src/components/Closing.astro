---
import InstallRow from './InstallRow.astro';
---

<section class="closing" aria-labelledby="closing-title">
  <div class="container closing-grid">
    <h2 id="closing-title">Linear, for agents.</h2>
    <div class="closing-actions">
      <InstallRow />
      <div class="closing-links">
        <a class="btn btn-primary" href="https://github.com/wsoule/dispatch/releases/latest">
          Download the app
        </a>
        <a class="btn" href="#demo">Try the live demo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    padding: var(--site-gap) 0;
  }
  .closing-grid {
    display: grid;
    grid-template-columns: var(--site-rail) minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
  }
  h2 {
    grid-column: 2;
  }
  .closing-actions {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .closing-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (max-width: 720px) {
    .closing-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    h2,
    .closing-actions {
      grid-column: 1;
    }
  }
</style>
