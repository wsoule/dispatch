---
import InstallRow from './InstallRow.astro';
---

<section class="hero" id="install" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title">Linear, for agents.</h1>
    <p class="lede">
      Chatting is overrated. Every session on one board: what it's doing, what blocks it, what's
      next.
    </p>
    <div class="hero-actions">
      <InstallRow />
      <div class="hero-links">
        <a class="btn btn-primary" href="https://github.com/wsoule/dispatch/releases/latest">
          Download the app
        </a>
        <a class="btn" href="#demo">Try the live demo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--site-gap) 0 var(--space-10);
  }
  h1 {
    max-width: 14ch;
  }
  .lede {
    margin-top: var(--space-5);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
