---
import Section from './Section.astro';
---

<Section id="land" number="04" label="Land" title="Green lands. You don't babysit.">
  <p class="sub">
    A merge queue. Reviewed, green work lands without you watching it.
  </p>
  <figure>
    <img
      class="shot"
      src="/shots/git.jpg"
      alt="The Git view: every branch and worktree the project's agents created"
      width="1680"
      height="960"
      loading="lazy"
    />
    <figcaption class="caption">
      Git. Every branch and worktree the agents created, and what's still on disk.
    </figcaption>
  </figure>
</Section>

<style>
  figure {
    margin: 0;
  }
</style>
