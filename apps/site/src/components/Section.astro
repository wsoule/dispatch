---
// One stop on the walk-through. The rail on the left carries the step number and a
// one-word label; the body carries the heading and whatever the section shows.
interface Props {
  id: string;
  number: string;
  label: string;
  title: string;
}
const { id, number, label, title } = Astro.props;
const headingId = `${id}-title`;
---

<section class="walk" id={id} aria-labelledby={headingId}>
  <div class="container walk-grid">
    <div class="walk-rail">
      <span class="walk-num mono" aria-hidden="true">{number}</span>
      <span class="walk-label">{label}</span>
    </div>
    <div class="walk-body">
      <h2 id={headingId}>{title}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  .walk {
    padding: var(--site-gap) 0 0;
  }
  .walk-grid {
    display: grid;
    grid-template-columns: var(--site-rail) minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
  }
  .walk-rail {
    position: sticky;
    top: calc(var(--site-nav-height) + var(--space-6));
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--site-text-sm);
    color: var(--text-secondary);
    line-height: 1.3;
  }
  .walk-num {
    font-size: var(--site-text-sm);
    color: var(--text-primary);
  }
  .walk-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }
  .walk-body h2 {
    max-width: 22ch;
  }
  @media (max-width: 720px) {
    .walk-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .walk-rail {
      position: static;
      flex-direction: row;
      gap: var(--space-3);
    }
  }
</style>
