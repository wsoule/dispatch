    border-radius: 10px;
    background: #0c0c0e;
  }
  .ov-side {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .col-head {
    padding: 0.45rem 0.6rem;
    border-radius: 7px;
    background: rgb(255 255 255 / 5%);
    font-weight: 500;
  }
  .col-head span,
  .ov-empty {
    color: var(--ink-3);
  }
