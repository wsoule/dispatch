  }
  .ov-thinking {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    animation: rise 400ms var(--ease) both;
  }
  .spin {
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid var(--ink-3);
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 800ms linear infinite;
  }
  .ov-card {
    padding: 0.8rem 0.9rem;
    border: 1px solid rgb(240 138 60 / 45%);
    border-radius: 10px;
    background: rgb(240 138 60 / 7%);
    animation: rise 450ms var(--ease) both;
  }
  .ov-card-head {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--ink-3);
  }
  .ov-need {
    color: #f0a060;
    font-weight: 600;
  }
  .ov-card-head code {
    font-size: 0.72rem;
  }
  .ov-card-title {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .ov-plan {
    display: grid;
    gap: 0.2rem;
    margin: 0.6rem 0 0.75rem;
    padding: 0;
    color: var(--ink-2);
    list-style: none;
  }
  .ov-plan li {
    display: flex;
    gap: 0.6rem;
  }
  .ov-wave {
    width: 3.6rem;
    color: var(--ink-3);
  }
  .ov-actions {
    display: flex;
    gap: 0.4rem;
  }
  .ov-approve,
  .ov-deny {
    position: relative;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-weight: 500;
    transition:
      transform 150ms var(--ease),
      background 150ms var(--ease);
  }
  .ov-approve {
    background: var(--accent-strong);
  }
  .ov-deny {
    border: 1px solid var(--line-2);
  }
  .ov-approve.press {
    background: #4a4ec4;
    transform: scale(0.94);
  }
  /* A pointer glides to Approve and clicks it. */
  .cursor {
    position: absolute;
    top: 60%;
    left: 70%;
    width: 14px;
    height: 20px;
    background: #fff;
    clip-path: polygon(0 0, 0 78%, 26% 60%, 44% 100%, 58% 94%, 40% 56%, 72% 56%);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 60%));
    opacity: 0;
    pointer-events: none;
  }
  .ov-approve.aim .cursor {
    animation: aim 900ms var(--ease) both;
  }
  @keyframes aim {
    from {
      opacity: 0;
      transform: translate(70px, 50px);
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
  .ov-applied {
    margin-top: 0.4rem;
    color: var(--review);
    animation: rise 350ms var(--ease) both;
  }
  .ov-composer {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: #111113;
    transition: border-color 300ms var(--ease);
  }
  .win.typing .ov-composer {
    border-color: rgb(139 143 248 / 60%);
  }
  .ov-input {
    min-height: 2.6em;
    font-size: 0.88rem;
  }
  .ov-ph {
    color: var(--ink-3);
  }
  .ov-caret {
    display: none;
    width: 1.5px;
    height: 1em;
    margin-left: 1px;
    background: var(--ink);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  .win.typing .ov-caret {
    display: inline-block;
  }
  .win.typing .ov-ph {
    display: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .ov-tools {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.45rem;
  }
  .ov-tools span {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.72rem;
  }
  .ov-send {
    width: 1.5rem;
    height: 1.5rem;
    margin-left: auto;
    border-radius: 50%;
    background: rgb(255 255 255 / 8%);
    transition: background 200ms var(--ease);
  }
  .win.typing .ov-send {
    background: var(--accent-strong);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .ov-after {
    margin-left: auto;
    color: var(--ink-3);
  }
  .ov-wave {
    width: 1.2rem;
  }
  /* What just landed and what it freed, beside the stats. */
  .notice {
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(139 143 248 / 45%);
    border-radius: 999px;
    background: rgb(91 95 214 / 18%);
    color: var(--ink);
  }
  .notice.in {
    animation: rise 400ms var(--ease) both;
  }
  /* A link flashes the moment its blocker lands. */
  .link.just::before {
    animation: flash 1100ms var(--ease);
  }
  @keyframes flash {
    from {
      border-top-color: #fff;
      box-shadow: 0 0 12px 2px var(--accent);
    }
  }
  .card.unblocked[data-state='working'] {
    animation: wake 1200ms var(--ease);
  }
  @keyframes wake {
    from {
      box-shadow:
        inset 3px 0 0 var(--working),
        0 0 0 4px rgb(139 143 248 / 45%);
    }
  }

  @media (max-width: 1000px) {
    .chrome-tag,
    .views .view:not(.on),
    .stats-right,
    .strip-right,
    .crumbs-right {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .ov {
      grid-template-columns: minmax(0, 1fr);
    }
    .ov-side {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .ov-thread {
      min-height: 18rem;
    }
    .top {
      grid-template-columns: auto 1fr;
    }
    .who {
      grid-column: 1;
      grid-auto-flow: column;
      gap: 0.8rem;
    }
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tab span {
      display: none;
    }
    .waves {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 0;
    }
    .link {
      height: 0.8rem;
    }
    .link::before {
      display: none;
    }
    .done {
      position: static;
      margin-top: 1rem;
      justify-content: start;
    }
    .composer {
      display: none;
    }
  }
</style>

<script>
  // Plays the hero story. Card state lives on each card's data-state and every
  // count is recomputed from those states; the Overseer scene is driven by
  // toggling hidden elements. Each pass of the loop checks `run` so a restart
  // cancels the pass before it.
  const win = document.querySelector<HTMLElement>('[data-plan]');
  if (win) {
    const $ = <T extends Element = HTMLElement>(sel: string) => win.querySelector<T>(sel)!;
    const cards = [...win.querySelectorAll<HTMLElement>('[data-card]')];
    const byId = (id: string) => cards.find((c) => c.dataset.card === id)!;
    const arc = $<SVGCircleElement>('[data-arc]');
    const orbN = $('[data-orb-n]');
    const typed = $('[data-typed]');
    const me = $('[data-me]');
    const hint = $('[data-hint]');
    const thinking = $('[data-thinking]');
    const proposal = $('[data-proposal]');
    const approve = $('[data-approve]');
    const actions = $('[data-actions]');
    const applied = $('[data-applied]');
    const turns = new Map<HTMLElement, number>();
    const costs = new Map<HTMLElement, number>();
    const prompt =
      'Plan a milestone “Checkout v2”: an Apple Pay button, saved cards and address autocomplete, then wire Apple Pay into checkout, then release notes.';
    // Pause / Play. A paused story holds at its next step; reduced-motion
    // readers start paused and can press Play.
    const pauseBtn = win.querySelector<HTMLButtonElement>('[data-pause]')!;
    let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const showPause = () => {
      pauseBtn.textContent = paused ? 'Play' : 'Pause';
      pauseBtn.setAttribute('aria-pressed', String(paused));
      win.classList.toggle('paused', paused);
    };
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      showPause();
    });
    showPause();
    const unpaused = () =>
      new Promise<void>((resolve) => {
        const check = () => (paused ? setTimeout(check, 150) : resolve());
        check();
      });
    // Every pause in the story is scaled by this; lower plays faster.
    const PACE = 0.6;
    let run = 0;
    let ticker = 0;

    const setAll = (key: string, value: number | string) => {
      for (const el of win.querySelectorAll<HTMLElement>(`[data-c="${key}"]`)) el.textContent = String(value);
    };
    const statusText = (c: HTMLElement) => {
      switch (c.dataset.state) {
        case 'working':
          return `Working, turn ${turns.get(c) ?? 1}`;
        case 'review':
          return 'Ready for review';
        case 'landed':
          return 'Landed';
        default:
          return c.dataset.wait ?? '';
      }
    };
    const render = () => {
      const n = (s: string) => cards.filter((c) => c.dataset.state === s).length;
      const working = n('working');
      const review = n('review');
      const landed = n('landed');
      setAll('working', working);
      setAll('review', review);
      setAll('running', working);
      setAll('landed', landed);
      setAll('landedAll', 3 + landed);
      setAll('blocked', n('waiting') > 0 ? 2 : 0);
      $('[data-chip="working"]').classList.toggle('lit', working > 0);
      $('[data-chip="review"]').classList.toggle('lit', review > 0);
      win.querySelectorAll('[data-slots] i').forEach((dot, i) => dot.classList.toggle('on', i < working));
      orbN.textContent = String(working + review);
      orbN.hidden = working + review === 0;
      arc.style.strokeDasharray = `${(landed / cards.length) * 100} 100`;
      arc.style.opacity = landed ? '1' : '0';
      let spent = 0;
      for (const c of cards) {
        const cost = costs.get(c) ?? 0;
        spent += cost;
        c.querySelector('[data-cost]')!.textContent = `$${cost.toFixed(2)}`;
        c.querySelector('[data-status]')!.textContent = statusText(c);
      }
      $('[data-spend]').textContent = `$${spent.toFixed(2)}`;
      for (const wave of win.querySelectorAll<HTMLElement>('[data-wave]')) {
        const mine = cards.filter((c) => c.dataset.waveOf === wave.dataset.wave);
        const done = mine.filter((c) => c.dataset.state === 'landed').length;
        $(`[data-wave-done="${wave.dataset.wave}"]`).textContent = String(done);
        wave.classList.toggle('live', mine.some((c) => c.dataset.state === 'working'));
        wave.classList.toggle('landed', done === mine.length);
      }
      // A link lights up as soon as the one task it waits on has landed.
      for (const link of win.querySelectorAll<HTMLElement>('[data-link-from]')) {
        const clear = byId(link.dataset.linkFrom!).dataset.state === 'landed';
        if (clear && !link.classList.contains('clear')) link.classList.add('just');
        link.classList.toggle('clear', clear);
      }
      const all = landed === cards.length;
      win.toggleAttribute('data-done', all);
      $('[data-summary]').textContent = all ? 'Landed' : 'Not yet';
    };
    const set = (ids: string[], state: string) => {
      for (const id of ids) {
        const c = byId(id);
        c.dataset.state = state;
        if (state === 'working') turns.set(c, 1);
      }
      render();
    };

    const notice = $('[data-notice]');
    let noticeTimer = 0;
    // A short line in the stats row saying what just landed and what it freed.
    const notify = (text: string) => {
      notice.textContent = text;
      notice.hidden = false;
      notice.classList.remove('in');
      void notice.offsetWidth;
      notice.classList.add('in');
      clearTimeout(noticeTimer);
      noticeTimer = window.setTimeout(() => (notice.hidden = true), 2200);
    };

    const reset = () => {
      notice.hidden = true;
      for (const l of win.querySelectorAll('[data-link-from]')) l.classList.remove('just');
      win.dataset.scene = 'overseer';
      win.classList.remove('typing', 'fresh');
      typed.textContent = '';
      hint.hidden = false;
      for (const el of [me, thinking, proposal, applied]) el.hidden = true;
      actions.hidden = false;
      approve.classList.remove('aim', 'press');
      for (const c of cards) {
        c.classList.remove('unblocked');
        c.dataset.state = 'waiting';
        costs.set(c, 0);
        turns.delete(c);
      }
      render();
    };

    async function story() {
      const mine = ++run;
      const wait = (ms: number) =>
        new Promise<void>((resolve, reject) =>
          setTimeout(
            () => void unpaused().then(() => (mine === run ? resolve() : reject(new Error('restarted')))),
            ms * PACE
          )
        );
      reset();
      // Overseer: type the project, send it, get a plan back, approve it.
      await wait(700);
      win.classList.add('typing');
      for (const ch of prompt) {
        typed.textContent += ch;
        await wait(ch === ',' || ch === ':' ? 140 : 24);
      }
      await wait(500);
      win.classList.remove('typing');
      typed.textContent = '';
      hint.hidden = true;
      me.textContent = prompt;
      me.hidden = false;
      await wait(450);
      thinking.hidden = false;
      await wait(1700);
      thinking.hidden = true;
      proposal.hidden = false;
      await wait(1500);
      approve.classList.add('aim');
      await wait(950);
      approve.classList.add('press');
      await wait(180);
      approve.classList.remove('press');
      actions.hidden = true;
      applied.hidden = false;
      await wait(1100);
      // Tasks: the five new tasks appear, then the milestone runs.
      win.classList.add('fresh');
      win.dataset.scene = 'plan';
      await wait(1300);
      win.classList.remove('fresh');
      const [pay, cardsTask, address, wire, notes] = cards.map((c) => c.dataset.card!);
      set([pay, cardsTask, address], 'working');
      await wait(2300);
      set([pay], 'review');
      await wait(900);
      // The blocker lands while the other two are still going, and the task
      // waiting on it starts right away.
      set([pay], 'landed');
      notify('Apple Pay button landed. Wire Apple Pay into checkout starts now.');
      await wait(900);
      set([wire], 'working');
      byId(wire).classList.add('unblocked');
      await wait(1700);
      set([cardsTask], 'review');
      await wait(900);
      set([cardsTask], 'landed');
      await wait(1600);
      set([wire], 'review');
      await wait(900);
      set([wire], 'landed');
      notify('Checkout wiring landed. Release notes starts now.');
      await wait(900);
      set([notes], 'working');
      byId(notes).classList.add('unblocked');
      await wait(1100);
      set([address], 'review');
      await wait(900);
      set([address], 'landed');
      await wait(1500);
      set([notes], 'review');
      await wait(900);
      set([notes], 'landed');
      notify('Checkout v2 landed. 5 of 5 tasks done by agents.');
      await wait(5500);
      void story().catch(() => {});
    }

    // Working agents take a turn now and then, and each turn costs a little.
    const tick = () => {
      if (paused) return;
      let any = false;
      for (const c of cards) {
        if (c.dataset.state !== 'working') continue;
        any = true;
        turns.set(c, (turns.get(c) ?? 1) + 1);
        costs.set(c, (costs.get(c) ?? 0) + 0.01 + Math.random() * 0.02);
      }
      if (any) render();
    };

    let started = false;
    new IntersectionObserver(
      (entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        if (visible && !started) {
          started = true;
          void story().catch(() => {});
        }
        if (visible && !ticker) ticker = window.setInterval(tick, 420);
        if (!visible && ticker) {
          clearInterval(ticker);
          ticker = 0;
        }
      },
      // Most of the window must be on screen, so the typing is seen from the start.
      { threshold: 0.55 }
    ).observe(win);
  }
</script>
