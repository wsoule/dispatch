---
import InstallCommand from './InstallCommand.astro';

const demo = 'https://dispatch-demo-production-aed7.up.railway.app';

// Real screenshots of the desktop app on the demo project, one per tab.
const shots = [
  ['tasks', 'Tasks', 'Every task grouped by milestone, with what needs you pinned on top.'],
  ['live', 'Live', 'Agents working in waves. A blocked task starts the moment its blocker lands.'],
  ['review', 'Review', 'The diff, the reviewer’s findings and the merge button, side by side.'],
  ['board', 'Board', 'The same tasks as columns, from draft to landed.'],
  ['overseer', 'Overseer', 'One conversation with the project, with what is coming in and going out beside it.'],
] as const;
---

<section class="feature" id="demo" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="demo-title">The real app. <em>Nothing here is a mockup.</em></h2>
      <p>
        Screenshots of Dispatch on a demo project, the same build you download. Pick a view, or{' '}
        <a href={demo} target="_blank" rel="noopener">try it live in your browser</a>.
      </p>
    </div>
    <div class="tour" data-tour>
      <div class="tabs" role="tablist" aria-label="App views">
        {
          shots.map(([id, label], i) => (
            <button
              type="button"
              role="tab"
              id={`tour-tab-${id}`}
              aria-controls={`tour-${id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {label}
            </button>
          ))
        }
      </div>
      {
        shots.map(([id, label, caption], i) => (
          <figure
            class="shot"
            id={`tour-${id}`}
            role="tabpanel"
            aria-labelledby={`tour-tab-${id}`}
            hidden={i !== 0}
          >
            <div class="frame panel">
              <img
                src={`/app/${id}.webp`}
                alt={`Dispatch ${label} view: ${caption}`}
                width="2400"
                height="1500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 id="closing-title">Linear, for agents.<br /><em>Available today.</em></h2>
    <p>Install the app, run <code>dispatch init</code> in a repo, and hand over your first task.</p>
    <div class="actions">
      <InstallCommand />
      <a class="btn btn-primary" href="https://github.com/wsoule/dispatch/releases/latest">
        Download for Mac
      </a>
    </div>
  </div>
</section>


<style>
  .section-head a {
    color: var(--ink);
    text-underline-offset: 3px;
  }
  .tour {
    margin: 3rem 0 0;
  }
  .tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.25rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-2);
  }
  .tabs button {
    flex: none;
    padding: 0.45rem clamp(0.7rem, 2.5vw, 1rem);
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font: 500 0.9rem/1 var(--body);
    cursor: pointer;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .tabs button:hover {
    color: var(--ink);
  }
  .tabs button[aria-selected='true'] {
    background: var(--panel-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--ink);
  }
  .tabs button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .shot {
    margin: 0;
  }
  .shot:not([hidden]) .frame {
    animation: shot-in 0.45s var(--ease);
  }
  .frame {
    overflow: hidden;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    text-align: center;
  }
  @keyframes shot-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:not([hidden]) .frame {
      animation: none;
    }
  }

  .closing {
    position: relative;
    padding: clamp(6rem, 14vw, 11rem) 0;
    overflow: hidden;
    text-align: center;
  }
  .closing::before {
    content: '';
    position: absolute;
    inset: 20% 10% -40%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(91 95 214 / 40%), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .closing .wrap {
    position: relative;
    display: grid;
  }
  .closing h2 {
    font-size: clamp(3.25rem, 9vw, 7rem);
  }
  .closing p {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    color: var(--ink-2);
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

</style>

<script>
  // Tabs for the screenshot tour: click or arrow keys switch the shown view.
  for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (next: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>
