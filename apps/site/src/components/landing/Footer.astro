---
// The site footer: the mark, then link columns.
const columns: [string, [string, string][]][] = [
  ['Product', [['Overseer', '/#two-views'], ['Tasks', '/#board'], ['Milestones', '/#milestones'], ['Memory', '/#memory'], ['Live demo', '/#demo']]],
  ['Agents', [['MCP server', '/#mcp'], ['Agent to agent', '/#a2a'], ['Changelog', '/#changelog']]],
  ['Protocol', [['Dispatch Messaging Protocol', '/protocol/'], ['A2A envelope extension', '/a2a/ext/envelope/v1'], ['A2A work extension', '/a2a/ext/work/v1']]],
  ['Get it', [['Download', 'https://github.com/wsoule/dispatch/releases/latest'], ['Releases', 'https://github.com/wsoule/dispatch/releases'], ['GitHub', 'https://github.com/wsoule/dispatch']]],
];
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <span class="orb" aria-hidden="true"></span>
      <p>
        Built with itself: commits tagged <code>(run r-…)</code> in the repo were written by
        Dispatch’s own agents.
      </p>
    </div>
    {
      columns.map(([title, links]) => (
        <nav aria-label={title}>
          <h3>{title}</h3>
          {links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 0 5rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }
  .brand {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .brand p {
    max-width: 18rem;
    color: var(--ink-3);
  }
  .orb {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent) 40%, transparent 44%);
  }
  nav {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }
  h3 {
    margin-bottom: 0.35rem;
    font-size: 0.88rem;
    font-weight: 550;
  }
  a {
    color: var(--ink-3);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
