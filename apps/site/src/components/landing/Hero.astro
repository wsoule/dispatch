---
import AppDemo from './AppDemo.astro';
import { DMG, RELEASES, WEB_APP } from '../../lib/downloads';
import InstallCommand from './InstallCommand.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="copy">
      <h1 id="hero-title">Give agents tasks, <em>not chats.</em></h1>
      <div class="sub">
        <p class="lede">
          The shared board your team’s agents work from, on your own machines. Plan in one
          sentence, watch agents work through it, and see exactly what stands between you and v1.
        </p>
        <a class="new" href="#web"><b>New</b> Dispatch on the web <span aria-hidden="true">→</span></a>
      </div>
      <div class="actions" id="install">
        <a class="btn btn-primary" href={DMG.arm}>Download for Mac</a>
        <InstallCommand />
      </div>
      <p class="alt">
        Apple Silicon. <a href={DMG.x64}>Intel Mac</a> or <a href={RELEASES}>Linux</a>. Or{' '}
        <a href={WEB_APP}>open the web app</a>.
      </p>
    </div>
  </div>

  <div class="wrap stage">
    <AppDemo />
  </div>
</section>

<style>
  .alt {
    margin-top: 0.9rem;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .alt a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .alt a:hover {
    color: var(--accent);
  }
  .hero {
    position: relative;
    padding: clamp(4rem, 10vw, 8rem) 0 0;
    overflow: hidden;
  }
  h1 {
    max-width: 12ch;
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.75rem;
  }
  .lede {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* The release note: a ruled mono strip that floods on hover. */
  .new {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .new b {
    color: var(--accent);
    font-weight: 700;
  }
  .new:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .new:hover b {
    color: var(--on-accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    scroll-margin-top: 6rem;
  }

  /* The app sits in the content column like every other drawn piece. */
  .stage {
    position: relative;
    margin-top: clamp(3.5rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
</style>
