---
import { WEB_APP } from '../../lib/downloads';

// The sticky site header. On phones the links fold into a Menu disclosure
// (a plain <details>, so it works without script).
const links: [string, string][] = [
  ['MCP', '/#mcp'],
  ['A2A', '/#a2a'],
  ['Tour', '/#demo'],
  ['Docs', '/docs'],
  ['Pricing', '/pricing'],
  ['Protocol', '/protocol/'],
  ['GitHub', 'https://github.com/wsoule/dispatch'],
];
---

<header class="nav">
  <div class="bar">
    <span class="reg tl" aria-hidden="true"></span>
    <span class="reg tr" aria-hidden="true"></span>
    <span class="reg bl" aria-hidden="true"></span>
    <span class="reg br" aria-hidden="true"></span>
    <a class="mark" href="/" aria-label="Dispatch home">
      <span class="glyph" aria-hidden="true"></span>
      Dispatch
    </a>
    <nav aria-label="Site">
      {
        links.map(([label, href]) => (
          <a class="link" href={href}>
            {label}
          </a>
        ))
      }
      <a class="link" href={WEB_APP}>Sign in</a>
      <a class="install" href="/#install">Install</a>
      <details class="menu">
        <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
        <div class="sheet">
          {links.map(([label, href]) => <a href={href}>{label}</a>)}
          <a href={WEB_APP}>Sign in</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* A flush, hatched bar at the top of the page. Once the page scrolls,
     Landing.astro sets html.nav-detached and the bar lifts into a floating
     box with registration marks on its corners. Hovering floods it indigo. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    transition: top 0.4s var(--ease-chrome);
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 100%;
    min-height: 4rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--border);
    background-color: var(--bg);
    background-image: var(--hatching);
    transition:
      max-width 0.4s var(--ease-chrome),
      padding 0.4s var(--ease-chrome),
      min-height 0.4s var(--ease-chrome),
      border-color 0.4s var(--ease-chrome),
      background-color 0.2s ease,
      color 0.2s ease;
  }
  :global(html.nav-detached) .nav {
    top: 12px;
  }
  :global(html.nav-detached) .bar {
    max-width: calc(var(--max) + var(--gutter) * 2 - 1rem);
    min-height: 3.4rem;
    padding: 0 1.4rem;
    border: 1px solid var(--border);
  }
  @media (hover: hover) {
    .bar:hover {
      background-color: var(--accent);
      color: var(--on-accent);
    }
    .bar:hover .link {
      color: var(--on-accent);
    }
    .bar:hover .glyph {
      background: var(--on-accent);
    }
    .bar:hover .install {
      border-color: var(--on-accent);
      background: var(--on-accent);
      color: var(--accent);
    }
    .bar:hover .reg {
      opacity: 0;
    }
  }

  /* Registration marks: two crossed 1px arms centered on the border line. */
  .reg {
    position: absolute;
    width: 11px;
    height: 11px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-chrome);
  }
  :global(html.nav-detached) .reg {
    opacity: 1;
  }
  .reg::before,
  .reg::after {
    content: '';
    position: absolute;
    background: var(--accent);
  }
  .reg::before {
    top: 5px;
    left: 0;
    width: 11px;
    height: 1px;
  }
  .reg::after {
    top: 0;
    left: 5px;
    width: 1px;
    height: 11px;
  }
  .tl {
    top: -6px;
    left: -6px;
  }
  .tr {
    top: -6px;
    right: -6px;
  }
  .bl {
    bottom: -6px;
    left: -6px;
  }
  .br {
    right: -6px;
    bottom: -6px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .glyph {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--accent);
    transition: background 0.2s ease;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .link {
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .install {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0 1rem;
    border: 2px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .menu {
    display: none;
    position: relative;
  }
  summary {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid currentColor;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .bars,
  .bars::before {
    display: block;
    width: 0.9rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms var(--ease);
  }
  .bars {
    transform: translateY(-3px);
  }
  .bars::before {
    content: '';
    transform: translateY(5px);
  }
  .menu[open] .bars {
    transform: rotate(45deg);
  }
  .menu[open] .bars::before {
    transform: rotate(-90deg);
  }
  .sheet {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    display: grid;
    min-width: 12rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--ink);
  }
  .sheet a {
    padding: 0.75rem 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .sheet a + a {
    border-top: 1px solid var(--line);
  }
  .sheet a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  @media (max-width: 860px) {
    .link {
      display: none;
    }
    .menu {
      display: block;
    }
    nav {
      gap: 0.6rem;
    }
    :global(html.nav-detached) .nav {
      top: 8px;
    }
    :global(html.nav-detached) .bar {
      max-width: calc(100% - 1rem);
      padding: 0 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .bar,
    .reg {
      transition: none;
    }
  }
</style>

<script>
  // Close the phone menu once a link in it is followed.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.menu')) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
  }
</script>
