---
import { shots, WIDTHS } from '../../data/shots';
import type { Shot, ShotName } from '../../data/shots';

// One app screenshot in a window frame. Both the light and the dark picture
// are in the page; CSS shows the one matching the page's theme, and a hidden
// lazy image is never fetched.
interface Props {
  name: ShotName;
  eager?: boolean;
  sizes?: string;
}
const { name, eager = false, sizes = '(min-width: 1200px) 1152px, 100vw' } = Astro.props;
const shot: Shot = shots[name];
const themes: ('light' | 'dark')[] = shot.darkOnly === true ? ['dark'] : ['light', 'dark'];
const srcset = (theme: string) =>
  WIDTHS.map((w) => `/shots/${shot.file}-${theme}-${w}.webp ${w}w`).join(', ');
---

<figure class:list={['shot', themes.length === 1 && 'single']}>
  {
    themes.map((theme) => (
      <img
        class={`on-${theme}`}
        src={`/shots/${shot.file}-${theme}-1600.webp`}
        srcset={srcset(theme)}
        sizes={sizes}
        alt={shot.alt}
        width={shot.width}
        height={shot.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))
  }
</figure>

<style>
  .shot {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--sunk);
    box-shadow: 0 24px 60px -32px rgb(0 0 0 / 35%);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Light picture by default; the dark one under a dark OS setting or a stored
     dark choice. A one-picture shot always shows. */
  .on-dark {
    display: none;
  }
  .single .on-dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .on-dark {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .on-light {
      display: none;
    }
  }
  :global(:root[data-theme='dark']) .on-dark {
    display: block;
  }
  :global(:root[data-theme='dark']) .on-light {
    display: none;
  }
</style>
