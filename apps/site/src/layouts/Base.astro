---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import tokensCss from '@dispatch/tokens/tokens.css?raw';
import { themeAwareTokens } from '../lib/themeTokens';
import '../styles/global.css';

// The palette is inlined rather than bundled so that the dark block can be
// re-emitted under the `data-theme` attribute the nav toggle sets. See
// src/lib/themeTokens.ts.
const tokens = themeAwareTokens(tokensCss);

interface Props {
  title?: string;
  description?: string;
  // A site path: an alias page names the immutable page it shows.
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
// A page that sets its own title or description also sets its link preview.
const ogTitle = title ?? 'Dispatch';
const ogDescription =
  description ??
  'Linear, for agents. A board, reviews, and a merge queue in your repo.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? 'Dispatch: Linear, for agents'}</title>
    <meta
      name="description"
      content={description ??
        'Linear, for agents. A board, reviews, and a merge queue, all markdown in your repo.'}
    />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {
      canonical !== undefined && (
        <link rel="canonical" href={`https://dispatch.foo${canonical}`} />
      )
    }
    <style is:inline set:html={tokens}></style>
    <!-- Applies a stored theme choice before first paint so the page never flashes the
         wrong palette. No choice stored means the OS setting applies. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('dispatch-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {
          /* Storage is unavailable (private mode, blocked). Fall through to the OS setting. */
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
