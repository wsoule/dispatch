---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/landing.css';

// The home page's own frame. The protocol pages keep Base.astro and the app's
// tokens; the landing page is always dark, in the app's beta look.
interface Props {
  // The 404 page: kept out of search and given no canonical link.
  notFound?: boolean;
}
const { notFound = false } = Astro.props;
const title = notFound ? 'Page not found: Dispatch' : 'Dispatch: Linear, for agents.';
const description =
  'Give agents tasks, not chats. Any agent connects over MCP, agents talk to each other across teams, and you see what blocks the release.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href="https://dispatch.foo/" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dispatch.foo/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dispatch.foo/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://dispatch.foo/og.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050506" />
  </head>
  <body>
    <slot />
    <script>
      // Starts each [data-seq-root] sequence the first time it is on screen.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('play');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.35 }
      );
      for (const el of document.querySelectorAll('[data-seq-root]')) io.observe(el);
    </script>
  </body>
</html>
