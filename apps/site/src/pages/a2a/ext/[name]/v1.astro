---
import { getEntry, render } from 'astro:content';

import Protocol from '../../../../layouts/Protocol.astro';
import { EXTENSIONS } from '../../../../lib/protocolSource';
import type { ExtensionName } from '../../../../lib/protocolSource';

// Each extension URI serves §8.3 and its own §8 subsection from the frozen
// version the manifest names for it, with a link to that whole document.
export function getStaticPaths() {
  return (Object.keys(EXTENSIONS) as ExtensionName[]).map((name) => ({
    params: { name },
  }));
}

const name = Astro.params.name as ExtensionName;
const entry = await getEntry('protocolExtensions', name);
if (entry === undefined)
  throw new Error(`the versions manifest names no version for ${name}/v1`);
const { version } = entry.data as { version: string };
const { Content } = await render(entry);
const uri = `https://dispatch.foo/a2a/ext/${name}/v1`;
---

<Protocol
  version={version}
  source="spec/08-a2a-binding.md"
  title={`Dispatch A2A extension: ${name} v1`}
  description={`The ${name}/v1 A2A extension of the Dispatch Messaging Protocol ${version}.`}
>
  <h1 class="mono ext-uri">{uri}</h1>
  <p class="ext-source">
    From §8 of the <a href={`/protocol/${version}/#s8`}>Dispatch Messaging Protocol {version}</a>.
  </p>
  <section class="spec-text">
    <Content />
  </section>
</Protocol>

<style>
  .ext-uri {
    font-size: var(--site-text-lg);
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .ext-source {
    margin-top: var(--space-3);
    color: var(--text-secondary);
  }
</style>
