---
import Footer from '../components/landing/Footer.astro';
import Nav from '../components/landing/Nav.astro';
import { releases } from '../data/releases';
import Landing from '../layouts/Landing.astro';
import '../styles/page.css';
---

<Landing
  title="Changelog: Dispatch"
  description="What changed in each Dispatch release."
  path="/changelog"
>
  <Nav />
  <main class="page">
    <div class="wrap">
      <div class="head">
        <h1>Changelog</h1>
        <p class="lede">
          What each release changed. Full notes and downloads are on{' '}
          <a href="https://github.com/wsoule/dispatch/releases">GitHub</a>.
        </p>
      </div>
      <ol class="log">
        {
          releases.map((r) => (
            <li>
              <p class="when">
                <code>{r.v}</code>
                <span>{r.date}</span>
              </p>
              <div>
                <h2>{r.title}</h2>
                <p>{r.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
  <Footer />
</Landing>

<style>
  .head a {
    color: var(--ink);
    text-underline-offset: 3px;
  }
  .log {
    max-width: 52rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .log li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .when {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .when code {
    color: var(--accent);
    font-family: var(--mono);
  }
  .log h2 {
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .log p {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .log li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
