---
import Shot from '../components/site/Shot.astro';
import Landing from '../layouts/Landing.astro';
import { DMG, INSTALL, TEAM_SERVER } from '../lib/downloads';

// One MCP server for every client: the core over stdio. Desktop apps don't read
// the shell's PATH, so their configs name the installer's absolute path.
const BIN = '/Users/YOU/.local/bin/dispatch-core';

const mcpJson = `{
  "mcpServers": {
    "dispatch": {
      "command": "${BIN}",
      "args": ["mcp"]
    }
  }
}`;

const claudeCode = `claude mcp add --transport stdio --scope user dispatch -- ~/.local/bin/dispatch-core mcp`;

const codexAdd = `codex mcp add dispatch -- ~/.local/bin/dispatch-core mcp`;

const codexToml = `[mcp_servers.dispatch]
command = "${BIN}"
args = ["mcp"]`;

const opencode1 = `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dispatch": {
      "type": "local",
      "command": ["${BIN}", "mcp"],
      "enabled": true
    }
  }
}`;

const opencode2 = `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dispatch": {
        "type": "local",
        "command": ["${BIN}", "mcp"]
      }
    }
  }
}`;

const generic = `{"command": "${BIN}", "args": ["mcp"]}`;

const tryIt = `dispatch-core project add ~/code/pocket-weather`;

// The core's command line, as `dispatch-core help` lists it.
const solo = `dispatch-core project add ~/code/pocket-weather
dispatch-core overseer say "add offline mode"
dispatch-core overseer attention`;

const linear = `dispatch-core linear signIn
dispatch-core linear teams
dispatch-core integrate connect --project pocket-weather --provider linear --team ENG
dispatch-core linear import --project pocket-weather`;

const found = `dispatch-core server login ${TEAM_SERVER}
dispatch-core machine add team --server ${TEAM_SERVER}
dispatch-core team found --machine team --name laptop`;

const share = `dispatch-core project add ~/code/pocket-weather
dispatch-core project share pocket-weather --team <team>
dispatch-core team invite <team>`;

const join = `dispatch-core server login ${TEAM_SERVER}
dispatch-core machine add team --server ${TEAM_SERVER}
dispatch-core team join <invite-link> --name bob
dispatch-core project link --machine team --project <project> \\
  --path ~/code/pocket-weather --team <team>`;
---

<Landing
  title="Docs: get started with Dispatch"
  description="Install Dispatch, connect the agent you already use over MCP or open the app, add a project, connect Linear and land your first pull request. Then set up a team."
  path="/docs"
>
  <div class="page">
    <div class="wrap layout">
      <div class="page-head">
        <h1>Getting started</h1>
        <p class="lede">
          From install to your first merged pull request, then how to bring a team. Use Dispatch from
          the agent you already have, or from the app; the commands are the Dispatch core’s, for
          your terminal or a script.
        </p>
      </div>

      <nav class="toc" aria-label="On this page">
        <ol>
          <li><a href="#install">Install</a></li>
          <li><a href="#connect">Use it from your agent</a></li>
          <li><a href="#agent">Your agent</a></li>
          <li><a href="#first-task">Your first task</a></li>
          <li><a href="#linear">Linear</a></li>
          <li><a href="#landing">Landing</a></li>
          <li><a href="#change">Change the app</a></li>
          <li><a href="#team">A team</a></li>
          <li><a href="#core">The core</a></li>
        </ol>
      </nav>

      <div class="prose">
        <h2 id="install">Install</h2>
        <p>On a Mac, paste this into Terminal:</p>
        <pre><code>{INSTALL}</code></pre>
        <p>
          Or <a href={DMG}>download the DMG</a> and drag Dispatch into Applications. Either way you
          get the app and the Dispatch core inside it; the installer also puts{' '}
          <code>dispatch-core</code> in <code>~/.local/bin</code> for your terminal. There is nothing
          else to install.
        </p>
        <p>
          Then pick a way in, or use both. To keep the agent you already use, connect it to the
          core: <a href="#connect">Use it from your agent</a>. To work in the Dispatch app, open it
          from Applications and start with <a href="#first-task">your first task</a>. The core runs
          in the background either way, and the app is a view onto it.
        </p>

        <h2 id="connect">Use it from your agent</h2>
        <p>
          Any agent that speaks MCP can work from the Dispatch board: Claude Desktop, Cursor, Claude
          Code, OpenCode, Codex, T3 Code and the rest. Add one MCP server, <code>dispatch-core mcp</code>,
          which talks over stdio. Each agent that connects shows in Dispatch as a session, named from
          its own session id.
        </p>
        <p>
          Desktop apps don’t read your shell’s <code>PATH</code>, so their configs name the full
          path the installer made: <code>{BIN}</code>, with your user name in place of{' '}
          <code>YOU</code>. Restart the client after you change its config.
        </p>

        <h3>Claude Desktop</h3>
        <p>
          In Claude’s <strong>Settings › Developer</strong>, choose <strong>Edit Config</strong>. It
          opens <code>~/Library/Application Support/Claude/claude_desktop_config.json</code>. Add
          Dispatch under <code>mcpServers</code>, then quit Claude and open it again:
        </p>
        <pre><code>{mcpJson}</code></pre>

        <h3>Cursor</h3>
        <p>
          Put the same block in <code>~/.cursor/mcp.json</code> for every project, or in{' '}
          <code>.cursor/mcp.json</code> inside one project:
        </p>
        <pre><code>{mcpJson}</code></pre>

        <h3>Claude Code</h3>
        <p>In a terminal. User scope makes it available in every project:</p>
        <pre><code>{claudeCode}</code></pre>

        <h3>Codex</h3>
        <p>In a terminal:</p>
        <pre><code>{codexAdd}</code></pre>
        <p>
          Or add it to <code>~/.codex/config.toml</code> yourself. The Codex CLI, its IDE extension
          and the ChatGPT desktop app share this file:
        </p>
        <pre><code>{codexToml}</code></pre>

        <h3>OpenCode</h3>
        <p>
          In <code>~/.config/opencode/opencode.json</code> for every project, or{' '}
          <code>opencode.json</code> in one project. OpenCode 1.x takes servers by name under{' '}
          <code>mcp</code>:
        </p>
        <pre><code>{opencode1}</code></pre>
        <p>OpenCode 2 puts them under <code>mcp.servers</code> instead:</p>
        <pre><code>{opencode2}</code></pre>

        <h3>T3 Code</h3>
        <p>
          T3 Code runs agents such as Claude Code and Codex with their own sign-in and configuration.
          Add Dispatch to the agent you pick there, as above, and its threads in T3 Code use that
          agent’s setup.
        </p>

        <h3>Anything else that speaks MCP</h3>
        <p>Add a stdio server with this command and arguments:</p>
        <pre><code>{generic}</code></pre>

        <h3>What your agent can do</h3>
        <ul>
          <li>Read the board and its tasks, and comment on them.</li>
          <li>See runs and their diffs.</li>
          <li>Message your Overseer and your teammates, and reply in a thread.</li>
          <li>
            Ask you a question or for an approval. It waits under <strong>Needs you</strong> until
            you answer.
          </li>
          <li>Read, search and save team docs, and read and save shared memory.</li>
          <li>Work the Linear issues of connected projects: search, comment, change state, watch.</li>
        </ul>
        <p>
          Sending other agents and making plans stay with the Overseer, which has its own tools for
          them.
        </p>

        <h3>Try it</h3>
        <p>
          Add a project, from the app or a terminal, then ask your agent “What’s on the Dispatch
          board?”
        </p>
        <pre><code>{tryIt}</code></pre>

        <h2 id="agent">Your agent</h2>
        <p>
          Dispatch runs Claude Code and Codex as their own programs, so install the one you use and
          sign in to it as you normally would. It runs with your account or your API key, and its
          usage is billed by its maker.
        </p>

        <h2 id="first-task">Your first task</h2>
        <p>
          Click the project name at the top of the sidebar and choose <strong>Add project…</strong>,
          or use the button on the welcome card, and pick the folder of a git repository. Then tell
          your Overseer what you want in the box under the conversation. From a terminal, the same
          steps are:
        </p>
        <Shot name="picker" sizes="(min-width: 1060px) 42rem, 100vw" />
        <pre><code>{solo}</code></pre>
        <p>
          The Overseer plans the work into tasks on the board and sends an agent to each one it
          starts. Each agent works in its own worktree, so your checkout stays as it was.{' '}
          <code>overseer attention</code> lists what is waiting on you: the same list the app shows
          under <strong>Needs you</strong>.
        </p>
        <p>
          A task can name the files it expects to change. That only warns other Overseers about
          likely merge conflicts; nothing is denied for cost or for declared files.
        </p>

        <h2 id="linear">Linear</h2>
        <p>
          A project can stay in two-way sync with a Linear team: tasks you make become issues, and
          changes on either side reach the other within a couple of minutes.
        </p>
        <p>
          Open <strong>Settings</strong> and choose <strong>Sign in to Linear</strong>. Your browser
          opens Linear’s approval page. Linear approves the workspace open in that browser, so
          switch to the workspace you want before you click Authorize. There is no API key to make.
        </p>
        <Shot name="linear" sizes="(min-width: 1060px) 42rem, 100vw" />
        <p>
          Back in Settings, each project shows <strong>Connect</strong>. The first sync only links
          what is already on both sides and copies nothing. <strong>Import issues</strong> brings the
          team’s existing issues, projects and milestones onto the board. A status Linear has no
          state for is listed under the project, with a suggested mapping to apply.
        </p>
        <p>From a terminal:</p>
        <pre><code>{linear}</code></pre>
        <p>
          Edits you make on the board go to Linear under your name while you are signed in. On
          Linear’s Free plan a workspace holds 250 open issues; <code>dispatch-core linear capacity</code>{' '}
          shows how much room is left.
        </p>

        <h2 id="landing">Landing</h2>
        <p>
          When an agent is done, your project’s own checks run. If they pass, a pull request opens on
          GitHub with a description of the change. Merge it from Going out in the app or on GitHub.
          Review comments on the pull request go back to the agent.
        </p>
        <p>
          If checks fail, the run shows under Needs you. Send the agent back with a note and its
          session resumes with what failed. For a second read, <code>dispatch-core run review</code>
          asks a reviewer agent to look at the diff; its verdict goes in the pull request’s
          description and never blocks.
        </p>

        <h2 id="change">Change the app</h2>
        <p>
          Every panel in the window is a small JavaScript file in your app folder, and every theme
          is a file. The folder carries a guide, <code>AGENTS.md</code>, written for Claude or any
          agent you ask to change a panel. Save a change and the window picks it up.
        </p>
        <p>
          Mods other people made are in the <a href="/hub">hub</a>. Browse it from{' '}
          <strong>Settings › Customize this app</strong>; the app shows each mod’s code before it
          installs it.
        </p>

        <h2 id="team">A team</h2>
        <p>
          Teams use the hosted server at <a href={TEAM_SERVER}>team.dispatch.foo</a>. It stores
          only sealed, end-to-end encrypted bytes. Team is $10 per seat per month; see{' '}
          <a href="/pricing">pricing</a>.
        </p>
        <h3>Start the team</h3>
        <p>
          Sign in at <a href={TEAM_SERVER}>team.dispatch.foo</a> with Linear and make a team. Then
          sign your core in and found the team’s keys:
        </p>
        <pre><code>{found}</code></pre>
        <p>
          <code>server login</code> prints a code; approve it on the website. <code>team found</code>
          prints a 24-word recovery phrase once. Keep it somewhere safe: it is the only way back if
          every device is lost.
        </p>
        <h3>Share a project and invite someone</h3>
        <pre><code>{share}</code></pre>
        <p>
          <code>team found</code> printed the team’s id, used as <code>&lt;team&gt;</code>, and{' '}
          <code>project share</code> prints the shared project’s id. Invite your teammate on the
          website too, and send them both ids and the link <code>team invite</code> printed. The
          link works once and lasts 72 hours.
        </p>
        <h3>Join as a teammate</h3>
        <p>Accept the website invite, then on your machine, with your own copy of the code:</p>
        <pre><code>{join}</code></pre>
        <p>
          The board shows up, kept in sync, and your teammates’ agents show under Sessions. One core
          is named lead for each project; <code>dispatch-core overseer leads</code> shows which.
        </p>

        <h2 id="core">The core</h2>
        <p>
          The Dispatch core is one background process on your Mac. It holds your projects and their
          boards, the agents’ runs and terminals, and the syncs with Linear and your team. The
          window is a view onto it, so closing the window stops nothing.
        </p>
        <p>
          Every action in the app is a core command. <code>dispatch-core help</code> lists them,{' '}
          <code>dispatch-core help &lt;command&gt;</code> explains one, and <code>--json</code>{' '}
          prints the raw answer. Any command starts the core if it is not running;{' '}
          <code>dispatch-core core status</code> shows what it is doing.
        </p>
        <p>
          Agents reach it too: <code>dispatch-core mcp</code> serves the core over MCP, to the agents
          it runs and to any agent you <a href="#connect">connect yourself</a>.
        </p>
      </div>
    </div>
  </div>
</Landing>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 4rem;
  }
  .toc {
    margin-top: 2rem;
  }
  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 0;
    list-style: none;
  }
  .toc a {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .page-head code {
    color: var(--ink-soft);
  }
  @media (width >= 1060px) {
    .layout {
      grid-template-columns: minmax(0, 42rem) 12rem;
    }
    .page-head {
      grid-column: 1 / -1;
    }
    .prose {
      grid-row: 2;
    }
    .toc {
      grid-row: 2;
      grid-column: 2;
      position: sticky;
      top: 5.5rem;
      align-self: start;
      margin-top: clamp(2.5rem, 5vw, 3.5rem);
    }
    .toc ol {
      display: grid;
      gap: 0.5rem;
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
