---
import GetIt from '../components/site/GetIt.astro';
import PlanningTabs from '../components/site/PlanningTabs.astro';
import Shot from '../components/site/Shot.astro';
import Landing from '../layouts/Landing.astro';
import { DMG } from '../lib/downloads';

// The agents that can use Dispatch over MCP, for the first of the two ways.
const clients = [
  'Claude Desktop',
  'Cursor',
  'Claude Code',
  'OpenCode',
  'Codex',
  'T3 Code',
  'Anything else that speaks MCP',
];

// What brings the Overseer to you. Everything else keeps going without you.
const flags: [string, string][] = [
  ['A question', 'An agent cannot go on without an answer from you.'],
  ['A tool approval', 'An agent wants to run a command you have not allowed yet.'],
  ['Failed checks', 'Your project’s checks failed on an agent’s change.'],
  ['A pull request', 'The work is done and its pull request is ready to merge.'],
];

// How a finished task reaches main, in order.
const landing: [string, string][] = [
  ['Your checks run', 'The project’s own checks run on the agent’s branch.'],
  ['A pull request opens', 'It opens with a description of the change.'],
  ['GitHub merges it', 'Press Merge in Dispatch or on GitHub. Nothing queues in between.'],
  ['Comments go back', 'Review comments on the pull request go back to the agent that wrote it.'],
];

const mod = `// mods/statusbar/main.js, shortened
import { View, div } from "gpui-kit";
import { h_flex } from "gpui-base";
import { core, theme, px } from "dispatch";

export default class StatusBar extends View {
  render(cx) {
    const tok = theme().tokens;
    return h_flex()
      .px(px(16)).gap(px(12)).items_center()
      .bg(tok.base).text_color(tok.muted)
      .child(div().child(\`core \${core().version}\`));
  }
}`;

// The core from a terminal: the same calls the app makes.
const cli = `$ dispatch-core project add ~/code/pocket-weather
$ dispatch-core linear signIn
Signed in to Linear as Ada (Acme).
$ dispatch-core integrate connect --project pocket-weather --provider linear
$ dispatch-core overseer say "add offline mode"
$ dispatch-core overseer attention
$ dispatch-core run list`;
---

<Landing>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title">Tell your Overseer what you want. It sends the agents.</h1>
      <p class="lede">
        Dispatch keeps a board, docs and an Overseer for your coding agents, on your Mac. Use it
        from the agent you already have, or in the Dispatch app, where your Overseer plans the
        work, starts Claude Code or Codex, and only flags you down when a task needs you.
      </p>
      <GetIt />
    </div>
    <div class="wrap stage">
      <Shot name="hero" eager />
    </div>
  </section>

  <section class="section" id="two-ways" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ways-title">Two ways to use it.</h2>
        <p>
          Both use the same Dispatch core, installed by the same one line. It runs in the
          background either way, and the app is a view onto it.
        </p>
      </div>
      <div class="ways">
        <section aria-labelledby="way-agent-title">
          <p class="way-n">1</p>
          <h3 id="way-agent-title">From the agent you already use</h3>
          <p>
            For you if your setup works and you want to keep it. Add Dispatch to your agent as an
            MCP server. It can then read the board and comment on tasks, see runs and their diffs,
            message your Overseer and teammates, ask you for an approval, and read and save docs.
          </p>
          <ul class="clients">{clients.map((c) => <li>{c}</li>)}</ul>
          <a class="btn" href="/docs#connect">Connect your agent</a>
        </section>
        <section aria-labelledby="way-app-title">
          <p class="way-n">2</p>
          <h3 id="way-app-title">In the Dispatch app</h3>
          <p>
            For you if you want one place for all of it. A native Mac app with your Overseer, the
            board, five planning views and the Hub. Tell the Overseer what you want and it sends the
            agents; the rest of this page is about the app.
          </p>
          <ul class="clients">
            <li>Overseer</li>
            <li>Needs you</li>
            <li>Board</li>
            <li>Planning</li>
            <li>Hub</li>
          </ul>
          <a class="btn btn-primary" href={DMG}>Download for Mac</a>
        </section>
      </div>
    </div>
  </section>

  <section class="section tight" aria-labelledby="plain-title">
    <div class="wrap">
      <h2 id="plain-title" class="visually-hidden">How it works</h2>
      <ul class="points plain">
        <li>
          <h3>You talk to one Overseer</h3>
          <p>
            Say what you want in a sentence. It turns that into tasks on a board and decides what
            to start.
          </p>
        </li>
        <li>
          <h3>Agents run as themselves</h3>
          <p>
            Claude Code and Codex run as their own command line programs, on your machine, signed
            in with your account or your key.
          </p>
        </li>
        <li>
          <h3>Done means a pull request</h3>
          <p>Finished work passes your checks and opens on GitHub, ready for you to merge.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="needs-you" aria-labelledby="needs-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="needs-title">It interrupts you for four things.</h2>
        <p>
          Everything else keeps moving. A task can name the files it expects to change, and that
          only warns other Overseers about likely merge conflicts. Nothing is denied for cost or
          for the files a task touches.
        </p>
      </div>
      <ul class="flags">
        {
          flags.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
      <p class="aside">
        Each one waits under <b>Needs you</b> with a button per answer: approve, deny, merge or send
        the agent back.
      </p>
    </div>
  </section>

  <section class="section" id="pull-requests" aria-labelledby="pr-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pr-title">Finished work lands as a pull request.</h2>
        <p>
          Open any run to read what its agent did, answer it, and see the diff. When you want a
          second read, a reviewer agent can look at the change; its verdict goes in the pull
          request and never blocks it.
        </p>
      </div>
      <Shot name="run" />
      <ol class="points steps">
        {
          landing.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="yours" aria-labelledby="yours-title">
    <div class="wrap split">
      <div class="copy">
        <h2 id="yours-title">The app is yours to change.</h2>
        <p>
          The Dispatch app is native to the Mac, and every panel in it is a small JavaScript file in your app
          folder. Themes are files too. Edit one yourself, or ask Claude to change a panel for you,
          and the window picks up the change as soon as it is saved.
        </p>
        <p>
          The panels it ships with: the Overseer and Needs you, the board, sessions, a run view to
          talk to an agent about its task, the task page, a terminal, Going out for pull requests,
          and five planning views. Each comes in light and dark.
        </p>
      </div>
      <pre class="code" aria-label="A panel's source, shortened"><code>{mod}</code></pre>
    </div>
    <div class="wrap">
      <div class="board"><Shot name="board" /></div>
    </div>
  </section>

  <section class="section" id="core" aria-labelledby="core-title">
    <div class="wrap split">
      <div class="copy">
        <h2 id="core-title">Under the window, the core does the work.</h2>
        <p>
          The Dispatch core is one background process on your Mac. It holds your projects and their
          boards, starts each agent in its own worktree and terminal, and keeps Linear and your team
          in step. The window is a view onto it: close the window and your agents keep working.
        </p>
        <p>
          Everything the app does is a core command, about two hundred of them, so your terminal or
          a script can do it too. The core ships inside the app, and the installer puts{' '}
          <code>dispatch-core</code> on your path.
        </p>
      </div>
      <pre class="code" aria-label="The core from a terminal"><code>{cli}</code></pre>
    </div>
    <div class="wrap">
      <ul class="points">
        <li>
          <h3>Agents outlive the window</h3>
          <p>
            Runs, terminals and syncs belong to the core. Quit the app and they are where you left
            them when you come back.
          </p>
        </li>
        <li>
          <h3>A command for everything</h3>
          <p>
            <code>dispatch-core help</code> lists them all. Each is one call to the core, with{' '}
            <code>--json</code> for the raw answer.
          </p>
        </li>
        <li>
          <h3>Your agents can use it</h3>
          <p>
            <code>dispatch-core mcp</code> serves the core over MCP, so any agent can read the board
            and docs, comment on a task and message the Overseer.{' '}
            <a href="/docs#connect">Connect yours</a>
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="planning" aria-labelledby="planning-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="planning-title">Plan the week, not just the next task.</h2>
        <p>
          Five planning views read the same board your agents work from, so the plan and the work
          never drift apart.
        </p>
      </div>
      <PlanningTabs />
    </div>
  </section>

  <section class="section" id="teams" aria-labelledby="teams-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="teams-title">Bring your team. The server can’t read a word.</h2>
        <p>
          Teams share projects through a hosted server at team.dispatch.foo. It stores only sealed,
          end-to-end encrypted bytes, so it cannot read your task titles or your code.
        </p>
      </div>
      <Shot name="team" />
      <ul class="points">
        <li>
          <h3>One board, synced</h3>
          <p>Share a project and every teammate’s board stays in step with yours.</p>
        </li>
        <li>
          <h3>See their agents</h3>
          <p>Your teammates’ agents show beside your own, with what each is working on.</p>
        </li>
        <li>
          <h3>One lead per project</h3>
          <p>One core is named lead for each project, and its Overseer acts for everyone on it.</p>
        </li>
        <li>
          <h3>Works with Linear</h3>
          <p>
            Sign in to Linear from Settings, no API key, and keep each project in two-way sync with
            a Linear team. <a href="/docs#linear">How it works</a>
          </p>
        </li>
      </ul>
      <p class="aside">
        Working alone is free. A team is $10 per seat per month. <a href="/pricing">See pricing</a>
      </p>
    </div>
  </section>

  <section class="section closing" id="install" aria-labelledby="install-title">
    <div class="wrap">
      <h2 id="install-title">Install Dispatch.</h2>
      <p class="lede">
        Bring a project and an agent you already use. Connect the agent to Dispatch, or open the
        app and let the Overseer do the rest.
      </p>
      <GetIt />
    </div>
  </section>
</Landing>

<style>
  .hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3.5rem, 7vw, 5.5rem);
  }
  .hero h1 {
    max-width: 15ch;
  }
  .lede {
    max-width: 36rem;
    margin: 1.4rem 0 2.25rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .stage {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .tight {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .plain {
    margin-top: 0;
  }
  .plain h3 {
    font-size: 1.2rem;
  }

  /* The two ways in, side by side, numbered because the page refers to them. */
  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .ways section {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.9rem;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .way-n {
    color: var(--accent-ink);
    font-family: var(--mono);
    font-weight: 500;
  }
  .ways h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .ways section > p:not(.way-n) {
    color: var(--muted);
    text-wrap: pretty;
  }
  .clients {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }
  .clients li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .ways .btn {
    margin-top: 0.4rem;
  }

  /* The page's one orange device: the app's flag rule, for what needs you. */
  .flags {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .flags li {
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 3px solid var(--signal);
  }
  .flags h3 {
    color: var(--signal);
    font-size: 1.15rem;
  }
  .flags p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
  }
  .aside {
    margin-top: 2.25rem;
    color: var(--muted);
  }
  .aside b {
    color: var(--ink);
  }
  .aside a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }

  /* The landing steps really are a sequence, so they carry numbers. */
  .steps {
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
  }
  .steps h3::before {
    content: counter(step) '  ';
    color: var(--accent-ink);
    font-family: var(--mono);
    font-weight: 500;
  }

  .split {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  .copy p {
    max-width: 34rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 1.1rem;
    text-wrap: pretty;
  }
  .code {
    min-width: 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--code-bg);
    color: var(--code-ink);
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .board {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (width >= 960px) {
    .split {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .closing h2 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
  }
  .closing .lede {
    margin-top: 1rem;
  }
</style>
