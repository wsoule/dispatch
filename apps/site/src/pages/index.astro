---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LeadShot from '../components/LeadShot.astro';
import Board from '../components/Board.astro';
import Dispatch from '../components/Dispatch.astro';
import Review from '../components/Review.astro';
import Land from '../components/Land.astro';
import Repo from '../components/Repo.astro';
import LiveDemo from '../components/LiveDemo.astro';
import OpenSource from '../components/OpenSource.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main>
    <Hero />
    <LeadShot />
    <Board />
    <Dispatch />
    <Review />
    <Land />
    <Repo />
    <LiveDemo />
    {/* Held back until the e-c25f9c source publication lands; restore then. */}
    {false && <OpenSource />}
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>
