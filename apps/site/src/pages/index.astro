  <main>
    <Hero />
    <Principles />
    <BoardNotChat />
    <TwoViews />
    <AnyAgent />
    <AgentToAgent />
    <Memory />
    <WebApp />
    <Mermaid />
    <Changelog />
    <Faq />
    <Closing />
  </main>
  <Footer />
