---
import Footer from '../components/landing/Footer.astro';
import Nav from '../components/landing/Nav.astro';
import Landing from '../layouts/Landing.astro';
import '../styles/page.css';

const repo = 'https://github.com/wsoule/dispatch';
const contact = (subject: string) =>
  `mailto:hello@dispatch.foo?subject=${encodeURIComponent(subject)}`;

const faq: [string, string][] = [
  ['Is Dispatch open source?', 'It is open core. The pieces other tools integrate with (the core library, CLI, API client and MCP server) are MIT. The messaging protocol spec is Apache-2.0. The desktop app and daemon are source-available under FSL-1.1, and every release becomes Apache-2.0 two years after it ships. The team features are under the Elastic License 2.0.'],
  ['Can I use it at work for free?', 'Yes. Up to three people, every feature, commercial use included.'],
  ['What does the FSL allow?', 'Reading, building, modifying, self-hosting and redistributing the code for any purpose except shipping a competing product or service.'],
  ['What happens past three people?', 'A fourth invite is refused and says why. On a synced board, anyone past the seats keeps working locally and catches up when seats are added. Nothing is deleted, and an expired key falls back to the free plan instead of locking anyone out.'],
  ['Does my code go anywhere?', 'No. Runs use your machine, your checkout and your own agent and API key. The license key is checked on your machine with no phone-home. A team can sync over its own git branch instead of the relay.'],
  ['What if Dispatch goes away?', 'Your tasks are markdown in your repo, or a git receipt log you can copy into any repo to get a working board back. And each release turns Apache-2.0 two years on.'],
];
---

<Landing
  title="Pricing: Dispatch"
  description="Free for up to three people with every feature. Teams of four or more need a license key."
  path="/pricing"
>
  <Nav />
  <main class="page">
    <div class="wrap">
      <div class="head">
        <h1>Free for up to three.</h1>
        <p class="lede">
          Every feature, for you and two teammates, at work or anywhere else. Bigger teams need a
          license key.
        </p>
      </div>

      <div class="plans">
        <section class="plan panel">
          <h2>Free</h2>
          <p class="price">$0</p>
          <p class="for">Up to 3 people</p>
          <ul>
            <li>Every feature: Overseer, tasks, graph, review, merge queue</li>
            <li>Any MCP agent: Claude Code, Codex, Gemini CLI, your own</li>
            <li>Agent-to-agent messaging and team board sync</li>
            <li>Commercial use</li>
          </ul>
          <a class="btn btn-primary" href={`${repo}/releases/latest`}>Download</a>
        </section>
        <section class="plan panel">
          <h2>Team</h2>
          <p class="price">Talk to us</p>
          <p class="for">4 people or more</p>
          <ul>
            <li>Everything in Free</li>
            <li>A license key for as many seats as you need</li>
            <li>Early access while team pricing is set</li>
          </ul>
          <a class="btn" href={contact('Team license for Dispatch')}>Ask about a license</a>
        </section>
        <section class="plan panel">
          <h2>Organizations</h2>
          <p class="price">Talk to us</p>
          <p class="for">Many teams, many agents</p>
          <ul>
            <li>Everything in Team</li>
            <li>Help rolling out agent guardrails: write scope, spend caps, review</li>
            <li>Shape what governance features come next</li>
          </ul>
          <a class="btn" href={contact('Dispatch for our organization')}>Get in touch</a>
        </section>
      </div>

      <div class="prose">
        <h2>Licensing, plainly</h2>
        <dl class="faq">
          {
            faq.map(([q, a]) => (
              <div>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          The full map is in <a href={`${repo}/blob/main/LICENSING.md`}>LICENSING.md</a>; where it
          and a license text disagree, the license text wins. Questions:{' '}
          <a href="mailto:hello@dispatch.foo">hello@dispatch.foo</a>.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Landing>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
  }
  .plan h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .price {
    margin: 0.75rem 0 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .for {
    margin: 0.25rem 0 0;
    color: var(--ink-3);
  }
  .plan ul {
    flex: 1;
    margin: 1.25rem 0 1.75rem;
    padding-left: 1.1rem;
    color: var(--ink-2);
    line-height: 1.55;
  }
  .plan li {
    margin: 0.4rem 0;
  }
  .plan .btn {
    align-self: flex-start;
  }
  .faq {
    margin: 0;
  }
  .faq div {
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
  }
  .faq dt {
    color: var(--ink);
    font-weight: 600;
  }
  .faq dd {
    margin: 0.4rem 0 0;
  }
</style>
