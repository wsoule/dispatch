{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // knip infers most entry points from each package's `exports`/`bin` and from
  // the vite/playwright/tsdown configs. Only the three it cannot see are listed.
  "workspaces": {
    ".": {
      // Root-level tooling invoked from moon tasks and the moon-managed git
      // hooks (.moon/workspace.yml's vcs.hooks), not imported by anything.
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/server": {
      // The daemon's `bin` is src/bin.ts, but src/index.ts is the library face
      // (startServer) that the CLI and every server test reach for.
      "entry": ["src/index.ts"]
    },
    "apps/site": {
      // A static marketing site: server.ts serves public/ as browser assets,
      // so nothing under it is ever imported. Mirrors the `apps/site/public/**`
      // exclusion .oxlintrc.json already carries.
      "ignore": ["public/**"]
    },
    "packages/demo": {
      // storefront-src is a template copied into the generated demo repo
      // (see src/paths.ts's `template`), so nothing in this workspace ever
      // imports it. Unreferenced here is the point, not dead code.
      "ignore": ["storefront-src/**"]
    },
    "apps/demo": {
      // daemon.ts is spawned as a subprocess (`bun src/daemon.ts --root ...`)
      // by the manager and by test/daemon.test.ts, never imported — no
      // static analysis reaches it, so it needs the same explicit entry
      // packages/server's own bin gets.
      "entry": ["src/daemon.ts"],
      // public/ holds browser assets server.ts hands out as files (the landing
      // page and the expiry overlay), never imported — as in apps/site.
      "ignore": ["public/**"]
    }
  },

  // Resolved at runtime through `import.meta.resolve(...)` on the package.json
  // rather than imported — see executors/claude.ts locating the MCP server's
  // bin, and commands/daemon.ts locating dispatchd. Real dependencies that no
  // static analysis can see.
  //
  // @moonrepo/cli is the enabler knip's built-in `moonrepo` plugin checks for
  // (node_modules/knip/dist/plugins/moonrepo) — it turns on the plugin's scan
  // of moon.yml/.moon/tasks/*.yml, so it is used even though nothing invokes
  // its binary directly.
  //
  // lint-staged runs via `pnpm exec lint-staged` in `.moon/workspace.yml`'s
  // `vcs.hooks.pre-commit`; the moonrepo plugin only scans moon.yml and
  // .moon/tasks/*.yml, not .moon/workspace.yml, so it can't see this usage.
  "ignoreDependencies": [
    "@dispatch/mcp",
    "@dispatch/server",
    "@moonrepo/cli",
    "lint-staged"
  ],

  // pgrep/pkill are spawned by ensure-daemon-race.test.ts to inspect and clean
  // up stray daemon processes. carto is probed by the demo's preflight and is
  // deliberately optional — it degrades to a built-in scanner when absent.
  // System binaries, not anything this repo can declare.
  //
  // noop is moon's built-in no-op command (tag-publishable.yml's `prepublish`
  // guard runs it), not a real binary. tsdown is a real devDependency, but
  // only in the four tsdown-tagged packages (core/client/cli/mcp) — knip's
  // moonrepo plugin is root-only and checks .moon/tasks/*.yml commands
  // against the root package.json, which never lists per-package build
  // tools.
  "ignoreBinaries": ["pgrep", "pkill", "carto", "noop", "tsdown"]
}
