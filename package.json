{
  "name": "@dispatch/monorepo",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.207",
      "@dnd-kit/core": "6.3.1",
      "@dnd-kit/utilities": "3.2.2",
      "@fontsource/inter": "5.2.8",
      "@fontsource/jetbrains-mono": "5.3.0",
      "@happy-dom/global-registrator": "20.11.1",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@pierre/diffs": "1.3.1",
      "@pierre/trees": "1.0.0-beta.5",
      "@playwright/test": "1.62.0",
      "@railway/cli": "5.41.2",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-query": "5.101.2",
      "@tauri-apps/api": "2.11.1",
      "@tauri-apps/cli": "2.11.4",
      "@tauri-apps/plugin-dialog": "2.7.1",
      "@tauri-apps/plugin-notification": "2.3.3",
      "@tauri-apps/plugin-process": "2.3.1",
      "@tauri-apps/plugin-updater": "2.10.1",
      "@testing-library/dom": "10.4.1",
      "@testing-library/react": "16.3.2",
      "@types/bun": "1.3.12",
      "@types/node": "24.13.2",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@typescript/native-preview": "7.0.0-dev.20260128.1",
      "@vitejs/plugin-react": "6.0.3",
      "acorn": "8.16.0",
      "astro": "5.18.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cmdk": "1.1.1",
      "commander": "13.1.0",
      "cspell": "10.0.1",
      "dependency-cruiser": "18.1.1",
      "husky": "^9.1.7",
      "jscpd": "5.0.14",
      "knip": "6.29.0",
      "lint-staged": "16.2.7",
      "lucide-react": "1.25.0",
      "markdownlint-cli2": "0.23.2",
      "oxfmt": "0.27.0",
      "oxlint": "1.42.0",
      "oxlint-tsgolint": "0.11.3",
      "radix-ui": "1.6.4",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "react-markdown": "9.0.1",
      "remark-gfm": "4.0.0",
      "sonner": "2.0.7",
      "stylelint": "16.25.0",
      "stylelint-config-standard": "39.0.1",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "tsdown": "0.15.11",
      "tw-animate-css": "1.4.0",
      "type-coverage": "2.30.1",
      "typescript": "5.9.2",
      "vite": "8.1.4",
      "yaml": "2.9.0",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "ws": "bun --silent scripts/ws.ts",
    "tsc": "bun run ws \"*\" tsc --sequential",
    "test": "bun run ws \"*\" test --sequential",
    "build": "bun run ws \"*\" build --sequential",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/*/.next dist-sidecar packages/*/tsconfig.tsbuildinfo apps/*/tsconfig.tsbuildinfo",
    "clean:all": "bun run clean && rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "lint": "oxlint --type-aware --tsconfig tsconfig.oxlint.json .",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.oxlint.json --fix .",
    "lint:chrome": "bun scripts/check-chrome-utilities.ts",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:deadcode": "knip",
    "lint:deadcode:fix": "knip --fix",
    "lint:dup": "jscpd packages apps",
    "lint:arch": "depcruise packages apps",
    "lint:spelling": "cspell --no-progress --no-summary --show-suggestions .",
    "lint:md": "markdownlint-cli2",
    "lint:types": "type-coverage -p tsconfig.oxlint.json",
    "audit": "bun audit --audit-level=critical",
    "audit:all": "bun audit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cspell": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "type-coverage": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@types/node": "24.13.2",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --type-aware --tsconfig tsconfig.oxlint.json --fix"
    ],
    "**/*.{css,pcss,postcss}": [
      "stylelint --fix --allow-empty-input"
    ]
  }
}
