{
  "name": "@dispatch-foo/core",
  "version": "0.24.0",
  "description": "Shared model and helpers for Dispatch: tasks, runs, git and SQLite, used by the daemon, the CLI and the protocol engine.",
  "homepage": "https://dispatch.foo/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsoule/dispatch.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./carto": {
      "types": "./dist/carto.d.ts",
      "import": "./dist/carto.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "test": "bun test",
    "tsc": "tsgo --noEmit --pretty",
    "prepublishOnly": "moon run core:prepublish"
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
