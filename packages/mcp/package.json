{
  "name": "@dispatch-foo/mcp",
  "version": "0.24.0",
  "description": "Dispatch's MCP server: lets Claude Code, Codex, Gemini CLI or any MCP agent read and work the Dispatch task board, message other agents, and save memory.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "dispatch",
    "mcp",
    "model-context-protocol",
    "task-board"
  ],
  "homepage": "https://dispatch.foo/docs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsoule/dispatch.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "dispatch-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "test": "bun test",
    "tsc": "tsgo --noEmit --pretty",
    "prepublishOnly": "moon run mcp:prepublish"
  },
  "dependencies": {
    "@dispatch-foo/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dispatch/server": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "mcpName": "io.github.wsoule/dispatch"
}
