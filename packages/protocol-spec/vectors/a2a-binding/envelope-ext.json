{
  "kit": "1.0.0-draft.1",
  "class": "a2a-binding",
  "area": "envelope-ext",
  "vectors": [
    {
      "id": "a2a.envelope-ext.accepts-recipients-choices-and-message-refs",
      "title": "envelope/v1 metadata with recipients, a kind, choices and a message ref is accepted",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.4"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "envelope",
          "raw": {
            "to": ["human:wyat"],
            "kind": "question",
            "choices": ["yes", "no"],
            "refs": [
              {
                "type": "message",
                "id": "m-1"
              }
            ]
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": true
          }
        ]
      }
    },
    {
      "id": "a2a.envelope-ext.accepts-no-envelope",
      "title": "A message with no envelope/v1 metadata is accepted, and takes the defaults",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.4"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "envelope",
          "raw": null
        }
      ],
      "then": {
        "steps": [
          {
            "ok": true
          }
        ]
      }
    },
    {
      "id": "a2a.envelope-ext.refuses-urgent",
      "title": "A client cannot mark its message urgent: refused on urgent",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.4"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "envelope",
          "raw": {
            "urgent": true
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": false,
            "error": {
              "code": "forbidden",
              "field": "urgent"
            }
          }
        ]
      }
    },
    {
      "id": "a2a.envelope-ext.refuses-a-wake-request",
      "title": "A client cannot ask to wake a session: refused on wake",
