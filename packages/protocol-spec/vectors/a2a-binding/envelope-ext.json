    {
      "id": "a2a.envelope-ext.refuses-a-bad-recipient",
      "title": "envelope/v1 metadata whose to[] entry spans two lines is refused on that slot",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.4"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "envelope",
          "raw": {
            "to": ["human:a\nhuman:b"]
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": false,
            "error": {
              "code": "invalid",
              "field": "to[0]"
            }
          }
        ]
      }
    },
    {
      "id": "a2a.envelope-ext.refuses-a-ref-type-other-than-task-or-message",
