      "then": {
        "steps": [
          {
            "ok": true,
            "result": {
              "message": "$s1"
            }
          },
          {
            "ok": false,
            "error": {
              "code": "invalid",
              "field": "kind"
            }
          },
          {
            "ok": false,
            "error": {
              "code": "invalid",
              "field": "kind"
            }
          }
        ],
        "noOtherMessages": true,
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "agent:wyat/a2a.acme",
            "state": "held"
          }
        ]
      }
    },
    {
