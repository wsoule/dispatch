        {
          "op": "a2a.project",
          "facts": {
            "canceledAt": "2026-09-23T11:00:00.000Z",
            "answer": {
              "id": "m-ans",
              "thread": "m-root",
              "replyTo": "m-root",
              "from": "human:wyat",
              "to": ["agent:wyat/a2a.acme"],
              "kind": "answer",
              "body": "Yes, final.",
              "blocking": false
