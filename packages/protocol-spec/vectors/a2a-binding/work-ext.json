{
  "kit": "1.0.0-draft.1",
  "class": "a2a-binding",
  "area": "work-ext",
  "vectors": [
    {
      "id": "a2a.work-ext.accepts-a-handoff",
      "title": "A handoff request with a title, acceptance criteria, writes, a priority and labels is accepted",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.6"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "work",
          "raw": {
            "skill": "handoff",
            "title": "Rate-limit uploads",
            "acceptance": ["429 after 10 uploads a minute"],
            "writes": ["src/upload/**"],
            "priority": "high",
            "labels": ["api"]
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": true
          }
        ]
      }
    },
    {
      "id": "a2a.work-ext.accepts-a-status-request",
      "title": "A status request, with or without a task id, is accepted",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.6"],
      "given": {},
      "when": [
        {
