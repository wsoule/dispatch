  "vectors": [
    {
      "id": "a2a.work-ext.accepts-a-handoff-with-every-field",
      "title": "A handoff naming a title, acceptance criteria, repo-relative writes, a priority and labels is accepted",
      "class": "a2a-binding",
      "level": "MUST",
      "profile": "core",
      "sections": ["8.6"],
      "given": {},
      "when": [
        {
          "op": "a2a.validate",
          "extension": "work",
          "raw": {
            "skill": "handoff",
            "title": "Add rate limiting to the export API",
            "acceptance": ["Exports over 100 per minute get 429"],
            "writes": ["src/export/**", "docs/api.md"],
            "priority": "high",
            "labels": ["api", "Rate Limits"]
          }
        }
      ],
      "then": { "steps": [{ "ok": true }] }
    },
    {
      "id": "a2a.work-ext.accepts-a-status-request",
      "title": "A status request, with or without a task id, is accepted",
