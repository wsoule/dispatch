          "extension": "work",
          "raw": {
            "skill": "status",
            "task": "m-01"
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": true
          }
        ]
      }
    },
    {
      "id": "a2a.work-ext.refuses-an-unknown-skill",
