        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "body": "which?",
            "blocking": true
          }
        },
        {
          "op": "world",
          "change": { "endSession": { "workItem": "t-000001" } }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "b" }
        }
      ],
      "then": {
        "steps": [{ "ok": true }, null, { "ok": true }],
        "messages": [
          { "id": "$s3", "kind": "answer", "to": ["task:t-000001"] }
        ],
        "deliveries": [
          {
            "message": "$s3",
            "recipient": "task:t-000001",
            "via": "direct",
            "state": "held",
            "session": null
          }
        ]
      }
    },
