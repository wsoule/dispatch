    {
      "id": "core.answers.a-reply-answers-and-closes-the-question",
      "title": "A reply to a question is an answer in its thread to the asker, and moves the question to answered and out of the open list",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["4.6", "4.7", "6.1", "7.1"],
      "given": {
        "workItems": [{ "id": "t-000001", "liveSession": "run:r-000001" }],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "body": "which?",
            "blocking": true,
            "choices": ["a", "b"]
          }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "", "choice": "a" }
        },
        { "op": "openBlocking" }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true, "result": { "message": "$s2", "downgraded": false } },
          { "ok": true, "result": { "messages": [] } }
        ],
        "messages": [
          { "id": "$s1" },
          {
            "id": "$s2",
            "kind": "answer",
            "replyTo": "$s1",
            "thread": "$s1",
            "to": ["run:r-000001"],
            "choice": "a"
          }
        ],
        "noOtherMessages": true,
        "deliveries": [
          { "message": "$s1", "recipient": "human:wyat", "state": "answered" },
          {
            "message": "$s2",
            "recipient": "run:r-000001",
            "via": "direct",
            "state": "pushed",
            "session": "run:r-000001"
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s1" },
          { "hook": "published", "message": "$s2" },
          { "hook": "push", "session": "run:r-000001", "message": "$s2" }
        ],
        "gateEffects": []
      }
    },
    {
      "id": "core.answers.a-reply-to-an-ended-session-goes-to-its-work-item",
