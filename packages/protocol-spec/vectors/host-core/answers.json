              "via": "direct",
              "state": "notified"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "m-seed-q",
          "input": { "body": "yes" }
        },
        { "op": "openBlocking" },
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": { "to": ["run:r-0000a1"], "kind": "message", "body": "x" }
        }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true, "result": { "messages": [] } },
          { "ok": false, "error": { "code": "invalid", "field": "to[0]" } }
        ],
        "messages": [
          {
            "id": "$s1",
            "kind": "answer",
            "replyTo": "m-seed-q",
            "to": ["run:r-0000a1"]
          }
        ],
        "noOtherMessages": true,
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "run:r-0000a1",
            "via": "direct",
            "state": "held",
            "session": null
          },
          {
            "message": "m-seed-q",
            "recipient": "human:wyat",
            "state": "answered"
          }
        ]
      }
    },
