        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "wake task:t-000002?",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": false },
          "message": "$s1",
          "input": { "body": "", "choice": "approve" }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "", "choice": "approve" }
        }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": false, "error": { "code": "forbidden", "field": "replyTo" } },
          { "ok": true }
        ],
        "messages": [
          { "id": "$s1" },
          {
            "id": "$s3",
            "kind": "answer",
            "replyTo": "$s1",
            "choice": "approve"
          }
        ],
        "noOtherMessages": true,
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s1" },
          { "hook": "onAnswered", "question": "$s1", "answer": "$s3" },
          { "hook": "published", "message": "$s3" }
