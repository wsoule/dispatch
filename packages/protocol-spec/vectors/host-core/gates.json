      "then": {
        "steps": [{ "ok": true, "result": { "replayed": 0, "voided": 0 } }],
        "calls": [],
        "gateEffects": [],
        "voided": []
      }
    },
    {
      "id": "core.gates.an-agent-answer-is-voided-on-recover",
