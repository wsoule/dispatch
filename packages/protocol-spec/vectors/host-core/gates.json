{
  "kit": "1.0.0-draft.1",
  "class": "host-core",
  "area": "gates",
  "vectors": [
    {
      "id": "core.gates.unregistered-type-refused",
      "title": "Gate data of a type no registry lists is refused on data.type from any sender, while an x- type is private data",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.1", "5.3", "5.6"],
      "given": {
        "workItems": [{ "id": "t-000001", "liveSession": "run:r-000001" }],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "body": "x?",
            "data": { "type": "poll" }
          }
        },
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "poll?",
            "data": { "type": "poll" }
          }
        },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "body": "x?",
            "data": { "type": "x-poll", "n": 1 }
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "invalid", "field": "data.type" } },
          { "ok": false, "error": { "code": "invalid", "field": "data.type" } },
          { "ok": true }
        ],
        "messages": [{ "id": "$s3", "data": { "type": "x-poll", "n": 1 } }],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.gates.gate-data-on-a-notice-refused",
      "title": "Gate data travels only on questions and handoffs, even from the system, while x- data may ride on any kind",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.1", "5.3"],
      "given": {
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "notice",
            "body": "n",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["human:ada"],
            "kind": "message",
            "body": "m",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "notice",
            "body": "n",
            "data": { "type": "x-policy", "rung": 2 }
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "invalid", "field": "data.type" } },
          { "ok": false, "error": { "code": "invalid", "field": "data.type" } },
          { "ok": true }
        ],
        "messages": [
          { "id": "$s3", "data": { "type": "x-policy", "rung": 2 } }
        ],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.gates.an-unimplemented-registered-type-is-refused",
      "title": "A gate of a registered type the host does not implement is refused on data.type, even from the system",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.3", "5.6"],
      "given": {
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "decide?",
            "data": { "type": "$unimplementedGateType" }
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "invalid", "field": "data.type" } }
        ],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.gates.unknown-stored-gate-is-decide-only",
      "title": "A stored system gate of a type the host does not know takes only a deciding principal's answer, and applies no effect",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.4", "5.6"],
      "given": {
        "agents": [{ "address": "agent:wyat/claude", "status": "approved" }],
        "store": {
          "messages": [
            {
              "id": "m-unknown",
              "from": "$system",
              "to": ["agent:wyat/claude"],
              "kind": "question",
              "body": "decide",
              "blocking": true,
              "choices": ["approve", "deny"],
              "data": { "type": "future-gate", "ref": "x" }
            }
          ],
          "deliveries": [
            {
              "id": "d-unknown",
              "message": "m-unknown",
              "recipient": "agent:wyat/claude",
              "session": null,
              "state": "held"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "reply",
          "as": { "address": "agent:wyat/claude", "canDecide": false },
          "message": "m-unknown",
          "input": { "body": "", "choice": "approve" }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "m-unknown",
          "input": { "body": "", "choice": "approve" }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "forbidden", "field": "replyTo" } },
          { "ok": true }
        ],
        "messages": [
          {
            "id": "$s2",
            "kind": "answer",
            "replyTo": "m-unknown",
            "choice": "approve"
          }
        ],
        "noOtherMessages": true,
        "calls": [{ "hook": "published", "message": "$s2" }],
        "gateEffects": []
      }
    },
    {
      "id": "core.gates.agent-question-with-free-data-stays-plain",
      "title": "An agent's question whose data has an unknown unprefixed type is a plain question that its recipient may answer",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.1", "5.6"],
      "given": {
        "workItems": [{ "id": "t-000001", "sessions": ["run:r-000001"] }],
        "store": {
          "messages": [
            {
              "id": "m-free",
              "from": "agent:wyat/claude",
              "to": ["run:r-000001"],
              "kind": "question",
              "body": "which one?",
              "data": { "type": "poll", "n": 1 }
            }
          ],
          "deliveries": [
            {
              "id": "d-free",
              "message": "m-free",
              "recipient": "run:r-000001",
              "session": null,
              "state": "held"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "reply",
          "as": { "address": "run:r-000001", "canDecide": false },
          "message": "m-free",
          "input": { "body": "yes" }
        }
      ],
      "then": {
        "steps": [{ "ok": true }],
        "messages": [{ "id": "$s1", "kind": "answer", "replyTo": "m-free" }],
        "gateEffects": []
      }
    },
    {
      "id": "core.gates.choiceless-gate-takes-a-choiceless-answer",
      "title": "A gate without choices takes a deciding principal's answer without a choice, and applies its effect",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["4.7", "5.4", "5.5"],
      "given": {
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "body": "wake task:t-000002?",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "go ahead" }
        }
      ],
      "then": {
        "steps": [{ "ok": true }, { "ok": true }],
        "messages": [
          {
            "id": "$s2",
            "kind": "answer",
            "replyTo": "$s1",
            "body": "go ahead"
          }
        ],
        "callsInclude": [
          { "hook": "onAnswered", "question": "$s1", "answer": "$s2" }
        ],
        "gateEffects": ["$s1"]
      }
    },
    {
      "id": "core.gates.recover-leaves-an-unknown-gate-unapplied",
      "title": "Recovery neither applies nor records a stored gate of a type the host does not know, so a host that knows it still can",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.6", "6.3"],
      "given": {
        "store": {
          "messages": [
            {
              "id": "m-future",
              "from": "$system",
              "to": ["human:wyat"],
              "kind": "question",
              "body": "decide",
              "blocking": true,
              "choices": ["approve", "deny"],
              "data": { "type": "future-gate" }
            },
            {
              "id": "m-yes",
              "thread": "m-future",
              "replyTo": "m-future",
              "from": "human:wyat",
              "to": ["$system"],
              "kind": "answer",
              "body": "",
              "choice": "approve"
