      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.7", "6.1", "6.3", "13.4"],
      "given": {
        "agents": [{ "address": "agent:wyat/claude", "status": "approved" }],
        "store": {
          "messages": [
            {
              "id": "m-gate",
              "from": "$system",
              "to": ["human:wyat"],
              "kind": "question",
              "body": "wake task:t-000002?",
              "blocking": true,
              "choices": ["approve", "deny"],
              "data": {
                "type": "wake",
                "target": "task:t-000002",
                "message": "m-elsewhere"
              }
            },
            {
              "id": "m-bad",
              "thread": "m-gate",
              "replyTo": "m-gate",
              "from": "agent:wyat/claude",
              "to": ["$system"],
              "kind": "answer",
              "body": "",
              "choice": "approve"
            }
          ],
          "deliveries": [
            {
              "id": "d-gate",
              "message": "m-gate",
              "recipient": "human:wyat",
