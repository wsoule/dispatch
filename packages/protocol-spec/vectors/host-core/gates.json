          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "m-gate",
          "input": { "body": "", "choice": "approve" }
        }
      ],
      "then": {
        "steps": [
          { "ok": true, "result": { "replayed": 0, "voided": 1 } },
          { "ok": true, "result": { "messages": ["m-gate"] } },
          { "ok": true, "result": { "messages": ["m-gate"] } },
          { "ok": true }
        ],
        "messages": [
          { "id": "m-bad", "kind": "message" },
          {
            "id": "$s4",
            "kind": "answer",
            "replyTo": "m-gate",
            "choice": "approve"
          }
        ],
        "voided": ["m-bad"],
        "callsInclude": [
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "m-gate" },
          { "hook": "onAnswered", "question": "m-gate", "answer": "$s4" }
        ],
        "gateEffects": ["m-gate"]
      }
