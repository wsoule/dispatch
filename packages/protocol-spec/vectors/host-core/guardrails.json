    {
      "id": "core.guardrails.breaker-refuses-the-next-agent-turn",
      "title": "At the per-thread agent-turn limit an agent reply is limited on replyTo",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.6"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 2 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "message",
            "body": "ping"
          }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000002", "canDecide": false },
          "message": "$s1",
          "input": { "body": "pong" }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000001", "canDecide": false },
          "message": "$s2",
          "input": { "body": "ping again" }
        }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true },
          { "ok": false, "error": { "code": "limited", "field": "replyTo" } }
        ],
        "messages": [{ "id": "$s1" }, { "id": "$s2", "replyTo": "$s1" }],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.guardrails.breaker-tells-the-owner-once-per-window",
      "title": "The breaker sends the owner one x-breaker notice per window",
      "class": "host-core",
      "level": "SHOULD",
      "profile": "core",
      "sections": ["6.6"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 2 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "message",
            "body": "ping"
          }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000002", "canDecide": false },
          "message": "$s1",
          "input": { "body": "pong" }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000001", "canDecide": false },
          "message": "$s2",
          "input": { "body": "again" }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000001", "canDecide": false },
          "message": "$s2",
          "input": { "body": "and again" }
        },
        { "op": "thread", "thread": "$s1" }
      ],
      "then": {
        "steps": [
          null,
          null,
          null,
          null,
          { "ok": true, "result": { "messages": ["$s1", "$s2", "$notice1"] } }
        ],
        "messages": [
          {
            "id": "$notice1",
            "from": "$system",
            "to": ["human:wyat"],
            "kind": "notice",
            "replyTo": "$s2",
            "data": { "type": "x-breaker", "thread": "$s1" }
          }
        ]
      }
    },
    {
      "id": "core.guardrails.a-human-is-not-limited",
      "title": "A human may reply in a thread past the agent-turn limit",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.6"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 2 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "message",
            "body": "ping"
          }
        },
        {
          "op": "reply",
          "as": { "address": "run:r-000002", "canDecide": false },
          "message": "$s1",
          "input": { "body": "a" }
        },
