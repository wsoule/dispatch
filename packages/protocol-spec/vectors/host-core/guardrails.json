{
  "kit": "1.0.0-draft.1",
  "class": "host-core",
  "area": "guardrails",
  "vectors": [
    {
      "id": "core.guardrails.urgent-over-the-quota-is-downgraded",
      "title": "A session's urgent message over the hourly quota is sent without urgent and reported as downgraded",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.6"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 2, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": true, "result": { "message": "$s1", "downgraded": false } },
          { "ok": true, "result": { "message": "$s2", "downgraded": false } },
          { "ok": true, "result": { "message": "$s3", "downgraded": true } }
        ],
        "messages": [
          { "id": "$s1", "urgent": true },
          { "id": "$s2", "urgent": true },
          { "id": "$s3", "urgent": false }
        ]
      }
    },
    {
      "id": "core.guardrails.the-urgent-quota-window-slides",
      "title": "Urgent messages older than an hour no longer count toward the quota",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.6"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 2, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        { "op": "world", "change": { "advanceMs": 3660000 } },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true },
          null,
          { "ok": true, "result": { "message": "$s4", "downgraded": false } }
        ],
        "messages": [{ "id": "$s4", "urgent": true }]
      }
    },
    {
