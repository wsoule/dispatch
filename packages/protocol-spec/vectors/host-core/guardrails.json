          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 2, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["task:t-000002"],
            "kind": "notice",
            "body": "x",
            "urgent": true
          }
        },
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
