{
  "kit": "1.0.0-draft.1",
  "class": "host-core",
  "area": "read",
  "vectors": [
    {
      "id": "core.read.can-read-participants",
      "title": "The sender, a recipient, and every session that acts for either's work item may read a message",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["2.2", "4.6", "9.3"],
      "given": {
        "workItems": [
          {
            "id": "t-000001",
            "liveSession": "run:r-000011",
            "sessions": ["run:r-000001"]
          },
          {
            "id": "t-000002",
            "liveSession": "run:r-000002",
            "sessions": ["run:r-000012"]
          },
          { "id": "t-000003", "liveSession": "run:r-000003" }
        ],
        "agents": [{ "address": "agent:wyat/claude", "status": "approved" }],
        "store": {
          "messages": [
            {
              "id": "m-note",
              "from": "run:r-000001",
              "to": ["task:t-000002", "human:ada"],
              "kind": "message",
              "body": "the api moved"
            }
          ],
          "deliveries": [
            {
              "id": "d-task",
              "message": "m-note",
              "recipient": "task:t-000002",
              "session": null,
              "state": "held"
            },
            {
              "id": "d-ada",
              "message": "m-note",
              "recipient": "human:ada",
              "session": null,
              "state": "notified"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "canRead",
          "message": "m-note",
          "as": { "address": "run:r-000001", "canDecide": false }
        },
        {
          "op": "canRead",
          "message": "m-note",
          "as": { "address": "run:r-000011", "canDecide": false }
        },
        {
          "op": "canRead",
          "message": "m-note",
          "as": { "address": "human:ada", "canDecide": false }
        },
        {
          "op": "canRead",
          "message": "m-note",
          "as": { "address": "run:r-000002", "canDecide": false }
        },
        {
          "op": "canRead",
          "message": "m-note",
          "as": { "address": "run:r-000012", "canDecide": false }
        }
      ],
      "then": {
        "steps": [
          { "ok": true, "result": { "readable": true } },
          { "ok": true, "result": { "readable": true } },
          { "ok": true, "result": { "readable": true } },
          { "ok": true, "result": { "readable": true } },
          { "ok": true, "result": { "readable": true } }
        ]
      }
    },
