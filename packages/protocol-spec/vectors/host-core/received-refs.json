            "to": ["human:wyat"],
            "kind": "message",
            "body": "see the handbook",
            "refs": [{ "type": "wiki", "id": "handbook", "at": "s2" }]
          }
        }
      ],
      "then": {
        "steps": [
          {
            "ok": false,
            "error": { "code": "invalid", "field": "refs[0].type" }
          }
        ],
        "noOtherMessages": true
      }
    },
