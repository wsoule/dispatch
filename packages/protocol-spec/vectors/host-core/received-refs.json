      "level": "MUST",
      "profile": "dispatch",
      "sections": ["4.3", "C.1"],
      "given": {
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:ada", "canDecide": false },
          "input": {
            "to": ["human:wyat"],
            "kind": "message",
            "body": "see the API section",
            "refs": [
              {
                "type": "doc",
                "id": "doc-01k6abcdefghjkmnpqrstvwxyz",
                "at": "api"
