      "given": {
        "workItems": [{ "id": "t-4a8cce", "sessions": ["run:r-9f2c01"] }],
        "store": {
          "messages": [
            {
              "id": "m-seed-1",
              "from": "human:wyat",
              "to": ["task:t-4a8cce"],
              "kind": "message",
              "body": "hi"
            }
          ],
          "deliveries": [
            {
              "id": "d-seed-1",
              "message": "m-seed-1",
              "recipient": "task:t-4a8cce",
              "session": "run:r-9f2c01",
              "via": "direct",
              "state": "sending"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [{ "op": "recover" }],
      "then": {
        "steps": [
          {
            "ok": true,
            "result": { "retried": 0, "reverted": 1, "replayed": 0 }
          }
        ],
        "deliveries": [
          {
            "message": "m-seed-1",
            "recipient": "task:t-4a8cce",
            "state": "held",
            "session": null
          }
        ],
        "calls": []
      }
    },
