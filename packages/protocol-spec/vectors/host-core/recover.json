{
  "kit": "1.0.0-draft.1",
  "class": "host-core",
  "area": "recover",
  "vectors": [
    {
      "id": "core.recover.dispatches-sending-rows-whose-session-is-live",
      "title": "Recovery dispatches again a sending row whose session is live",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.3"],
      "given": {
        "workItems": [{ "id": "t-000002", "liveSession": "run:r-000002" }],
        "store": {
          "messages": [
            {
              "id": "m-seed-1",
              "from": "human:wyat",
              "to": ["task:t-000002"],
              "kind": "message",
              "body": "x"
            }
          ],
          "deliveries": [
            {
              "id": "d-seed-1",
              "message": "m-seed-1",
              "recipient": "task:t-000002",
              "session": "run:r-000002",
              "via": "direct",
              "state": "sending"
            }
          ]
        },
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [{ "op": "recover" }],
      "then": {
        "steps": [
          {
            "ok": true,
            "result": { "retried": 1, "reverted": 0, "replayed": 0 }
          }
        ],
        "deliveries": [
          {
            "message": "m-seed-1",
            "recipient": "task:t-000002",
            "state": "pushed",
            "session": "run:r-000002"
          }
        ],
        "calls": [
          { "hook": "push", "session": "run:r-000002", "message": "m-seed-1" }
        ]
      }
    },
    {
      "id": "core.recover.returns-sending-rows-to-held",
      "title": "Recovery returns a sending row whose session is gone to the mailbox",
