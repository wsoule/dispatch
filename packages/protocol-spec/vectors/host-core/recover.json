    {
      "id": "core.recover.replays-an-unapplied-gate-effect",
      "title": "Recovery applies again a deciding answer whose effect failed, records it, and does not apply it a third time",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["5.5", "6.3"],
      "given": {
        "owner": "human:wyat",
        "failOnAnswered": true,
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "wake task:t-000002?",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "", "choice": "approve" }
        },
        { "op": "world", "change": { "failOnAnswered": false } },
        { "op": "recover" },
        { "op": "recover" }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true },
          null,
          {
            "ok": true,
            "result": { "retried": 0, "reverted": 0, "replayed": 1 }
          },
          {
            "ok": true,
            "result": { "retried": 0, "reverted": 0, "replayed": 0 }
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s1" },
          { "hook": "onAnswered", "question": "$s1", "answer": "$s2" },
          { "hook": "published", "message": "$s2" },
          { "hook": "onAnswered", "question": "$s1", "answer": "$s2" }
        ],
        "gateEffects": ["$s1"]
      }
    },
    {
      "id": "core.recover.skips-applied-and-closed-gates",
      "title": "Recovery applies no effect for a gate already applied or closed",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["4.8", "6.3"],
      "given": {
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "wake task:t-000002?",
            "data": {
              "type": "wake",
              "target": "task:t-000002",
              "message": "m-elsewhere"
            }
          }
        },
        {
          "op": "reply",
          "as": { "address": "human:wyat", "canDecide": true },
          "message": "$s1",
          "input": { "body": "", "choice": "approve" }
        },
        {
          "op": "send",
          "as": { "address": "$system", "canDecide": true },
          "input": {
            "to": ["human:wyat"],
            "kind": "question",
            "blocking": true,
            "choices": ["approve", "deny"],
            "body": "wake task:t-000003?",
            "data": {
              "type": "wake",
              "target": "task:t-000003",
              "message": "m-elsewhere"
            }
          }
        },
        { "op": "close", "question": "$s3", "reason": "the run ended" },
        { "op": "recover" }
      ],
      "then": {
        "steps": [
          { "ok": true },
          { "ok": true },
          { "ok": true },
          { "ok": true },
          {
            "ok": true,
            "result": { "retried": 0, "reverted": 0, "replayed": 0 }
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s1" },
          { "hook": "onAnswered", "question": "$s1", "answer": "$s2" },
          { "hook": "published", "message": "$s2" },
          { "hook": "published", "message": "$s3" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s3" },
          { "hook": "published", "message": "$s4" }
        ],
        "gateEffects": ["$s1"]
      }
    }
  ]
}
