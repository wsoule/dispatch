              "kind": "question",
              "body": "Which region should the rollout start in?"
            },
            {
              "id": "m-ext",
              "thread": "m-q",
              "replyTo": "m-q",
              "from": "agent:wyat/a2a.acme",
              "to": ["human:wyat"],
              "kind": "message",
