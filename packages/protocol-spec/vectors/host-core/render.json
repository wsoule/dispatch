    {
      "id": "core.render.dispatch-push-format",
      "title": "The Dispatch profile's exact push text: header, quoted body, choices, refs and the reply prompt",
      "class": "host-core",
      "level": "MUST",
      "profile": "dispatch",
      "sections": ["6.8", "13.12", "C.6"],
      "given": {
        "workItems": [{ "id": "t-4a8cce", "liveSession": "run:r-9f2c01" }]
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["task:t-4a8cce"],
            "kind": "question",
            "body": "Did you change the API shape?\nsecond line",
            "refs": [{ "type": "file", "id": "src/api.ts", "at": "abc123" }],
            "urgent": true,
            "blocking": true,
            "choices": ["yes", "no"]
          }
        },
        { "op": "render", "message": "$s1" }
      ],
      "then": {
        "render": [
          {
            "step": 2,
            "text": "[message from human:wyat · question · urgent · $s1]\n│ Did you change the API shape?\n│ second line\nchoices: yes | no\nrefs: file:src/api.ts@abc123\nThe sender is waiting. Answer with msg_reply(messageId: \"$s1\")."
          }
        ]
      }
