        "calls": [{ "hook": "published", "message": "$s1" }]
      }
    },
    {
      "id": "core.send.never-delivers-to-the-senders-own-work-item",
      "title": "A session never gets a delivery for itself or its own work item, directly or through a channel",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["3.5"],
      "given": {
        "workItems": [{ "id": "t-000001", "liveSession": "run:r-000001" }],
        "channels": [{ "name": "auth", "members": ["task:t-000001"] }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": { "to": ["channel:auth"], "kind": "notice", "body": "x" }
        },
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["task:t-000001", "run:r-000001", "human:wyat"],
            "kind": "message",
            "body": "y"
          }
        }
      ],
      "then": {
        "steps": [{ "ok": true }, { "ok": true }],
        "noDeliveries": ["$s1"],
        "deliveries": [
          { "message": "$s2", "recipient": "human:wyat", "state": "notified" }
        ]
      }
    },
    {
      "id": "core.send.a-session-that-is-not-live-is-invalid",
      "title": "A plain message to a session that is not live fails invalid on its to[] slot and stores nothing",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.1"],
      "given": {
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": { "to": ["run:r-0000aa"], "kind": "message", "body": "x" }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "invalid", "field": "to[0]" } }
        ],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.send.an-ended-session-error-names-the-callers-own-slot",
      "title": "After a reply rewrites and collapses recipients, the error about a session that is not live names the caller's own to[] slot",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["3.5", "4.6", "6.1"],
      "given": {
        "workItems": [{ "id": "t-000001", "liveSession": "run:r-000001" }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": { "to": ["human:wyat"], "kind": "question", "body": "ok?" }
        },
        {
          "op": "world",
          "change": { "endSession": { "workItem": "t-000001" } }
        },
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["task:t-000001", "run:r-000001", "run:r-0000aa"],
            "kind": "message",
            "body": "see above",
            "replyTo": "$s1"
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": true },
          null,
          { "ok": false, "error": { "code": "invalid", "field": "to[2]" } }
        ],
        "messages": [{ "id": "$s1" }],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.send.unknown-channel-is-not-found",
