          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notifyHuman", "actor": "human:wyat", "message": "$s1" }
        ]
      }
    },
    {
      "id": "core.send.agent-mail-is-held",
      "title": "Mail to an agent waits in the agent's mailbox",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.1", "7.1"],
      "given": {
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["agent:wyat/claude-code.macbook"],
            "kind": "message",
            "body": "x"
          }
        }
      ],
      "then": {
        "deliveries": [
          {
            "message": "$s1",
