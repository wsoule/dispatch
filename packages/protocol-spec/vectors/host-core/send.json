            "state": "pushed",
            "session": "run:r-000002"
          }
        ]
      }
    },
    {
      "id": "core.send.human-mail-is-notified",
      "title": "Mail to a human is notified at once and calls the host's notifier",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.1", "6.2"],
      "given": {
        "workItems": [{ "id": "t-000001", "liveSession": "run:r-000001" }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": { "to": ["human:wyat"], "kind": "notice", "body": "fyi" }
