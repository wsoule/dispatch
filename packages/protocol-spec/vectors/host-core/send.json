      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["3.5", "3.7"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "channels": [{ "name": "auth", "members": ["task:t-000002"] }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["channel:auth", "task:t-000002"],
            "kind": "message",
            "body": "x"
          }
        }
      ],
      "then": {
        "deliveries": [
          {
            "message": "$s1",
