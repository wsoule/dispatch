{
  "kit": "1.0.0-draft.1",
  "class": "host-core",
  "area": "send",
  "vectors": [
    {
      "id": "core.send.task-held-without-live-session",
      "title": "A work item with no live session holds its mail",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.1", "6.2"],
      "given": {
        "workItems": [{ "id": "t-4a8cce" }],
        "owner": "human:wyat",
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": { "to": ["task:t-4a8cce"], "kind": "message", "body": "hi" }
        }
      ],
      "then": {
        "steps": [
          { "ok": true, "result": { "message": "$s1", "downgraded": false } }
        ],
        "messages": [
          {
            "id": "$s1",
            "thread": "$s1",
            "from": "human:wyat",
            "to": ["task:t-4a8cce"]
          }
        ],
        "noOtherMessages": true,
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "task:t-4a8cce",
            "via": "direct",
            "state": "held",
            "session": null
          }
        ],
        "calls": [{ "hook": "published", "message": "$s1" }]
      }
    },
    {
      "id": "core.send.direct-mail-pushes-to-the-live-session",
      "title": "Direct mail to a work item with a live session is pushed to it and starts its own thread",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["4.6", "6.1", "6.2"],
      "given": {
        "workItems": [{ "id": "t-4a8cce", "liveSession": "run:r-9f2c01" }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": { "to": ["task:t-4a8cce"], "kind": "message", "body": "hi" }
        }
      ],
      "then": {
        "messages": [{ "id": "$s1", "thread": "$s1" }],
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "task:t-4a8cce",
            "via": "direct",
            "state": "pushed",
            "session": "run:r-9f2c01"
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "push", "session": "run:r-9f2c01", "message": "$s1" }
        ]
      }
    },
    {
      "id": "core.send.channel-mail-notifies-the-live-session",
      "title": "Mail through a channel is notified, not pushed, unless urgent",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.2", "7.2"],
      "given": {
        "workItems": [{ "id": "t-4a8cce", "liveSession": "run:r-9f2c01" }],
        "channels": [{ "name": "auth", "members": ["task:t-4a8cce"] }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "human:wyat", "canDecide": true },
          "input": {
            "to": ["channel:auth"],
            "kind": "message",
            "body": "heads up"
          }
        }
      ],
      "then": {
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "task:t-4a8cce",
            "via": "channel",
            "state": "notified",
            "session": "run:r-9f2c01"
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "notify", "session": "run:r-9f2c01", "message": "$s1" }
        ]
      }
    },
    {
      "id": "core.send.urgent-channel-mail-is-pushed",
      "title": "An urgent message through a channel is pushed to a member with a live session",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["6.2", "7.2"],
      "given": {
        "workItems": [
          { "id": "t-000001", "liveSession": "run:r-000001" },
          { "id": "t-000002", "liveSession": "run:r-000002" }
        ],
        "channels": [{ "name": "auth", "members": ["task:t-000002"] }],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "run:r-000001", "canDecide": false },
          "input": {
            "to": ["channel:auth"],
            "kind": "notice",
            "body": "stop",
            "urgent": true
          }
        }
      ],
      "then": {
        "steps": [
          { "ok": true, "result": { "message": "$s1", "downgraded": false } }
        ],
        "messages": [{ "id": "$s1", "urgent": true }],
        "deliveries": [
          {
            "message": "$s1",
            "recipient": "task:t-000002",
            "via": "channel",
            "state": "pushed",
            "session": "run:r-000002"
          }
        ],
        "calls": [
          { "hook": "published", "message": "$s1" },
          { "hook": "push", "session": "run:r-000002", "message": "$s1" }
        ]
      }
    },
    {
      "id": "core.send.direct-beats-channel",
