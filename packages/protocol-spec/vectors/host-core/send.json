    {
      "id": "core.send.only-approved-agents-send",
      "title": "An unregistered, pending or revoked agent is forbidden on from; an approved agent sends",
      "class": "host-core",
      "level": "MUST",
      "profile": "core",
      "sections": ["4.5", "9.1"],
      "given": {
        "agents": [
          { "address": "agent:wyat/pending-bot", "status": "pending" },
          { "address": "agent:wyat/old-bot", "status": "revoked" },
          { "address": "agent:wyat/claude-code.macbook", "status": "approved" }
        ],
        "limits": { "urgentPerHour": 10, "agentTurnsPerThreadPerHour": 20 }
      },
      "when": [
        {
          "op": "send",
          "as": { "address": "agent:wyat/stranger", "canDecide": false },
          "input": { "to": ["human:wyat"], "kind": "message", "body": "x" }
        },
        {
          "op": "send",
          "as": { "address": "agent:wyat/pending-bot", "canDecide": false },
          "input": { "to": ["human:wyat"], "kind": "message", "body": "x" }
        },
        {
          "op": "send",
          "as": { "address": "agent:wyat/old-bot", "canDecide": false },
          "input": { "to": ["human:wyat"], "kind": "message", "body": "x" }
        },
        {
          "op": "send",
          "as": {
            "address": "agent:wyat/claude-code.macbook",
            "canDecide": false
          },
          "input": { "to": ["human:wyat"], "kind": "message", "body": "x" }
        }
      ],
      "then": {
        "steps": [
          { "ok": false, "error": { "code": "forbidden", "field": "from" } },
          { "ok": false, "error": { "code": "forbidden", "field": "from" } },
          { "ok": false, "error": { "code": "forbidden", "field": "from" } },
          { "ok": true, "result": { "message": "$s4", "downgraded": false } }
        ],
        "messages": [{ "id": "$s4", "from": "agent:wyat/claude-code.macbook" }],
        "noOtherMessages": true
      }
    },
    {
      "id": "core.send.an-ended-session-reached-through-a-channel-gets-nothing",
