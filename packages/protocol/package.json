{
  "name": "@dispatch/protocol",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "dmp-reference-adapter": "./dist/conformance-adapter.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
