{
  "name": "@dispatch-foo/protocol",
  "version": "0.2.0",
  "description": "Reference engine for the Dispatch Messaging Protocol: addresses, envelopes, gates, delivery and a SQLite store.",
  "homepage": "https://dispatch.foo/protocol/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsoule/dispatch.git",
    "directory": "packages/protocol"
  },
  "bin": {
    "dmp-reference-adapter": "./dist/conformance-adapter.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "import": "./dist/federation/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "test": "bun test",
    "tsc": "tsgo --noEmit --pretty",
    "prepublishOnly": "moon run protocol:prepublish"
  },
  "dependencies": {
    "@dispatch-foo/core": "workspace:*"
  },
  "devDependencies": {
    "@dispatch-foo/protocol-spec": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
